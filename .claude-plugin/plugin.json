{
  "name": "kiln",
  "description": "Build and revise 3D assets with your coding agent. Write JavaScript, inspect selected views, edit saved source revisions, and export GLB files locally.",
  "version": "1.2.2",
  "author": {
    "name": "Matthew Kissinger"
  },
  "homepage": "https://github.com/instruktlabs/kiln",
  "license": "MIT",
  "keywords": [
    "3d",
    "glb",
    "gltf",
    "asset-generation",
    "three.js",
    "gamedev"
  ],
  "mcpServers": {
    "kiln": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp-server.mjs"
      ],
      "env": {
        "KILN_RENDER": "auto"
      }
    }
  }
}

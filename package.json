  "files": [
    "lib/",
    "dist/viewer/",
    "src/**/*.ts",
    "src/**/*.mjs",
    "src/generated/*.json",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "dist/*.mjs",
    "dist/build.json",
    "plugin.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/plugins/",
    "plugins/kiln-engine/",
    ".mcp.json",
    "scripts/create-workspace.mjs",
    "scripts/package-plugin.mjs",
    "render-service/src/",
    "render-service/package.json",
    "render-service/package-lock.json",
    "render-service/README.md",
    "skills/",
    "docs/architecture.md",
    "docs/cameras.md",
    "docs/chatgpt.md",
    "docs/collections.md",
    "docs/community-exporter.md",
    "docs/engine-handoff.md",
    "docs/examples.md",
    "docs/export-profiles.md",
    "docs/extending.md",
    "docs/geometry.md",
    "docs/google.md",
    "docs/harnesses.md",
    "docs/install.md",
    "docs/material-library.md",
    "docs/migration.md",
    "docs/programs.md",
    "docs/projects-and-live-review.md",
    "docs/rendering.md",
    "docs/runtime.md",
    "docs/sdk.md",
    "docs/tools.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "kiln": "bun src/cli.ts",
    "check:toolchain": "bun scripts/check-toolchain.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "build:mcp": "node scripts/build-runtime.mjs mcp",
    "build:cli": "node scripts/build-runtime.mjs cli",
    "build:worker": "node scripts/build-runtime.mjs worker",
    "build:runtime": "node scripts/build-viewer.mjs && node scripts/build-runtime.mjs all",
    "build:viewer": "node scripts/build-viewer.mjs",
    "docs:tools": "bun scripts/generate-tool-reference.ts",
    "mcp:manifest": "bun scripts/generate-mcp-manifest.ts",
    "test": "KILN_SPIKE_LIVE=0 KILN_RENDER=cpu bun test src scripts --path-ignore-patterns='{site,scenes}/**' --timeout 20000",
    "test:coverage": "KILN_SPIKE_LIVE=0 KILN_RENDER=cpu bun test src scripts --path-ignore-patterns='{site,scenes}/**' --coverage --timeout 20000 && bun scripts/check-coverage.mjs",
    "test:live": "KILN_SPIKE_LIVE=1 bun test --timeout 20000",
    "test:package": "node scripts/test-plugin-package.mjs && node scripts/smoke-package.mjs",
    "test:render-service": "npm --prefix render-service test",
    "lint": "biome check --error-on-warnings .",
    "verify:posters": "bun scripts/verify-posters.mjs",
    "site:assets": "cd site && bun scripts/build-assets.mjs",
    "site:skills": "cd site && bun scripts/build-skills-discovery.mjs",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "smoke:harness": "node scripts/harness-smoke.mjs",
    "dogfood:gallery": "node scripts/dogfood-gallery.mjs",
    "dogfood:tier2": "node scripts/tier2-dogfood.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "test:sdk": "node scripts/smoke-sdk.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "^2.3.0",
    "@types/three": "^0.186.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "gltf-validator": "2.0.0-dev.3.10",
    "manifold-3d": "^3.5.4",
    "minisearch": "7.2.0",
    "pngjs": "7.0.0",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "three-subdivide": "1.1.5",
    "xatlasjs": "^0.2.0",
    "zod": "^4.6.5"
  },

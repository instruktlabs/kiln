    "@ai-sdk/provider": "^3.0.0",
    "@strands-agents/sdk": "^1.18.0",
    "@openrouter/ai-sdk-provider": "^2.10.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "@strands-agents/sdk": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.18",
    "@anthropic-ai/sdk": "0.109.1",
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@biomejs/biome": "^2.5.15",
    "@google/genai": "^2.27.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@strands-agents/sdk": "1.19.0",
    "@types/bun": "^1.4.2",
    "ai": "^6.0.300",
    "openai": "^6.49.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "webgpu": "0.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instruktlabs/kiln.git"
  },
  "homepage": "https://github.com/instruktlabs/kiln",
  "bugs": {

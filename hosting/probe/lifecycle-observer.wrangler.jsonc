{
  "name": "kiln-local-lifecycle-observer",
  "main": "./lifecycle-observer.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 8798, "local_protocol": "http" },
  "services": [{
    "binding": "PROBE",
    "service": "kiln-private-lifecycle-v1-operator",
    "entrypoint": "KilnLifecycleControl",
    "remote": true
  }]
}

{
  "name": "kiln-private-manifest-startup",
  "main": "./manifest-startup-worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "limits": { "cpu_ms": 30000, "subrequests": 50 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "containers": [
    {
      "name": "kiln-private-manifest-startup",
      "class_name": "KilnManifestStartupJob",
      "scheduling_policy": "durable_object",
      "images": {
        "control": {
          "image": "registry.cloudflare.com/56adffd40534f7fe110fc661a40bbf53/kiln-evaluation@sha256:db79551579a9abd33f7589a4da4d57947364ddf3dd37b79f766e202f2703edc8"
        }
      },
      "observability": { "logs": { "enabled": false } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STARTUP_JOB", "class_name": "KilnManifestStartupJob" }
    ]
  },
  "exports": {
    "KilnManifestStartupControl": { "type": "worker" },
    "KilnManifestStartupJob": { "type": "durable-object", "storage": "sqlite" }
  }
}

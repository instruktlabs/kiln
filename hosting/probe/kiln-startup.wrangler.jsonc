{
  "name": "kiln-private-image-startup",
  "main": "./kiln-startup-worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "limits": { "cpu_ms": 30000, "subrequests": 50 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "containers": [
    {
      "name": "kiln-private-image-startup",
      "class_name": "KilnImageStartupJob",
      "scheduling_policy": "durable_object",
      "images": {
        "control": {
          "image": "registry.cloudflare.com/56adffd40534f7fe110fc661a40bbf53/kiln-evaluation@sha256:69aff70b4f0f80d2ff13549f4b55b1053fc1d8a6e25a00168ac4078a2ebd7b8a"
        }
      },
      "observability": { "logs": { "enabled": false } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STARTUP_JOB", "class_name": "KilnImageStartupJob" }
    ]
  },
  "exports": {
    "KilnImageStartupControl": { "type": "worker" },
    "KilnImageStartupJob": { "type": "durable-object", "storage": "sqlite" }
  }
}

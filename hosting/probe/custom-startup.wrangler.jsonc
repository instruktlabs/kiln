{
  "name": "kiln-private-custom-startup",
  "main": "./custom-startup-worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "limits": { "cpu_ms": 30000, "subrequests": 50 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "containers": [
    {
      "name": "kiln-private-custom-startup",
      "class_name": "KilnCustomStartupJob",
      "scheduling_policy": "durable_object",
      "images": {
        "control": {
          "image": "registry.cloudflare.com/56adffd40534f7fe110fc661a40bbf53/kiln-startup-control@sha256:a747ad80c8a161b650d79a6da9c422005b91148b18b8d2c669eb5a0b7c07e600"
        }
      },
      "observability": { "logs": { "enabled": false } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STARTUP_JOB", "class_name": "KilnCustomStartupJob" }
    ]
  },
  "exports": {
    "KilnCustomStartupControl": { "type": "worker" },
    "KilnCustomStartupJob": { "type": "durable-object", "storage": "sqlite" }
  }
}

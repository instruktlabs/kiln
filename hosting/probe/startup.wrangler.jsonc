{
  "name": "kiln-private-startup-diagnostic",
  "main": "./startup-worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "limits": { "cpu_ms": 30000, "subrequests": 50 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "containers": [
    {
      "name": "kiln-private-managed-startup",
      "class_name": "KilnManagedStartupJob",
      "scheduling_policy": "durable_object",
      "observability": { "logs": { "enabled": false } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STARTUP_JOB", "class_name": "KilnManagedStartupJob" }
    ]
  },
  "exports": {
    "KilnStartupControl": { "type": "worker" },
    "KilnManagedStartupJob": { "type": "durable-object", "storage": "sqlite" }
  }
}

# Private coordinator image. Never build with the repository or secrets as context.
FROM node:22.23.3-trixie-slim@sha256:154ba2f4d6fec323d28e4f4bb86bba4677f1223391a1979cf521304e03a98dfa
RUN npm install --global npm@12.2.0 --ignore-scripts --no-audit --no-fund
WORKDIR /opt/kiln
COPY candidate.tgz candidate.sha256 package.json package-lock.json ./
RUN sha256sum -c candidate.sha256 \
    && npm ci --omit=dev --include=optional --ignore-scripts --no-audit --no-fund \
    && dpkg-query -W > os-packages.txt \
    && node --version > node-version.txt
COPY native-mcp.mjs native-host.mjs serve.mjs ./
ENV KILN_RENDER=cpu
USER node
EXPOSE 3000
CMD ["node", "/opt/kiln/serve.mjs"]

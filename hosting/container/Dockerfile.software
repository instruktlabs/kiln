# Private per-job software-rendering candidate. Use the four-file context from README.md.
FROM node:22.23.3-trixie-slim@sha256:154ba2f4d6fec323d28e4f4bb86bba4677f1223391a1979cf521304e03a98dfa
# Trixie's Mesa supports the shader features required by the packaged Dawn renderer.
RUN apt-get update && apt-get install -y --no-install-recommends \
    mesa-vulkan-drivers libvulkan1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global npm@12.2.0 --ignore-scripts --no-audit --no-fund
WORKDIR /opt/kiln
COPY candidate.tgz candidate.sha256 ./
RUN sha256sum -c candidate.sha256 \
    && npm init -y \
    && npm install ./candidate.tgz --omit=dev --include=optional --ignore-scripts --no-audit --no-fund \
    && dpkg-query -W > os-packages.txt \
    && node --version > node-version.txt \
    && set -- /usr/share/vulkan/icd.d/lvp_icd*.json \
    && test "$#" -eq 1 && test -f "$1" \
    && ln -s "$1" /opt/kiln/lvp-icd.json
COPY evaluate.mjs ./
ENV VK_ICD_FILENAMES=/opt/kiln/lvp-icd.json
ENV KILN_RENDER=cpu
# The VM, outside deadline and network policy enforce isolation, not this UID.
USER node
CMD ["/usr/bin/sleep", "infinity"]

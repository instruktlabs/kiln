---
import { PACKS_ENABLED } from '../lib/config';
import { holodeckSite } from '../lib/holodeck';
import { sceneSelectorGroups } from '../lib/scene-selector';
interface Props { current?: string }
const { current = '' } = Astro.props;
---
<scene-selector class="my-6 block" data-holodeck={holodeckSite}>
  <label class="flex flex-wrap items-center gap-3">
    <span class="text-sm font-semibold">Choose a Kiln scene</span>
    <select class="min-h-11 max-w-full border border-rule bg-paper px-3 text-ink">
      <option value="" selected={!current}>Select a scene…</option>
      {sceneSelectorGroups(PACKS_ENABLED).map(group => <optgroup label={group.label}>
        {group.options.map(option => <option value={option.href} selected={current === option.id}>{option.name}</option>)}
      </optgroup>)}
    </select>
  </label>
</scene-selector>
<script>
  class SceneSelector extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      // A choice goes to one of this site's scene pages or to a world on Holodeck, and nowhere else.
      const holodeck = this.dataset.holodeck;
      if (select) select.onchange = () => {
        if (select.value.startsWith('/scenes/') || (!!holodeck && select.value.startsWith(holodeck))) window.location.assign(select.value);
      };
    }
    disconnectedCallback() { const select = this.querySelector('select'); if (select) select.onchange = null; }
  }
  if (!customElements.get('scene-selector')) customElements.define('scene-selector', SceneSelector);
</script>

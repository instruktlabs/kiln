---
import { sceneBrowseGroups } from '../data/scenes';
import { PACKS_ENABLED } from '../lib/config';
interface Props { current?: string }
const { current = '' } = Astro.props;
---
<scene-selector class="my-6 block">
  <label class="flex flex-wrap items-center gap-3">
    <span class="text-sm font-semibold">Choose a Kiln scene</span>
    <select class="min-h-11 max-w-full border border-rule bg-paper px-3 text-ink">
      <option value="" selected={!current}>Select a scene…</option>
      {sceneBrowseGroups(PACKS_ENABLED).map(group => <optgroup label={group.label}>
        {group.scenes.map(scene => <option value={scene.href} selected={current === scene.id}>{scene.name}</option>)}
      </optgroup>)}
    </select>
  </label>
</scene-selector>
<script>
  class SceneSelector extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      if (select) select.onchange = () => { if (select.value.startsWith('/scenes/')) window.location.assign(select.value); };
    }
    disconnectedCallback() { const select = this.querySelector('select'); if (select) select.onchange = null; }
  }
  if (!customElements.get('scene-selector')) customElements.define('scene-selector', SceneSelector);
</script>

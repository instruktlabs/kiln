---
import { getCollection } from "astro:content";
import { DOC_GROUPS } from "../../lib/docs-navigation";
interface Props {
  current?: string;
  label?: string;
}
const { current, label = "Documentation" } = Astro.props;
const docs = await getCollection("docs");
const available = new Set(docs.map((entry) => entry.id));
---

<nav aria-label={label} class="space-y-6">
  {DOC_GROUPS.map((group) => (
    <div>
      <h2 class="mb-2 text-base font-semibold">{group.title}</h2>
      <ul class="m-0 list-none p-0">
        {group.pages
          .filter((page) => available.has(page.slug))
          .map((page) => (
            <li>
              <a
                href={`/docs/${page.slug}/`}
                aria-current={current === page.slug ? "page" : undefined}
                class:list={[
                  "docs-nav-link block min-h-11 py-2 text-sm",
                  { "font-semibold": current === page.slug },
                ]}
              >
                {page.label}
              </a>
            </li>
          ))}
      </ul>
    </div>
  ))}
</nav>

---
import { sceneRuntimes } from "virtual:kiln-scenes";
import { scenes, type SceneId } from "../data/scenes";
import { imageQualification, FULL_WIDTH_IMAGE_SIZES } from "../lib/catalog";
import { PACKS_ENABLED } from "../lib/config";

interface Props {
  scene: SceneId;
}
const { scene: id } = Astro.props;
const scene = scenes[id];
const runtime = sceneRuntimes[id];
const stateCopy = scene.available
  ? scene.copy.available
  : runtime
    ? scene.copy.preview
    : scene.copy.unavailable;
---

<scene-shell
  class="block border border-rule bg-stage"
  data-scene={id}
  data-kind={runtime?.kind ?? "none"}
  data-runtime-url={runtime?.url ?? ""}
  data-asset-base={scene.assetBase}
  data-error-text={scene.copy.errorText}
  data-frame-title={`${scene.name} scene`}
>
  <div data-intro>
    {PACKS_ENABLED && scene.posterImage && (
      <picture>
        <source
          type="image/avif"
          srcset={scene.posterImage.srcsetAvif}
          sizes={FULL_WIDTH_IMAGE_SIZES}
        />
        <img
          src={scene.poster}
          srcset={scene.posterImage.srcsetWebp}
          sizes={FULL_WIDTH_IMAGE_SIZES}
          width={scene.posterWidth}
          height={scene.posterHeight}
          alt={scene.posterAlt}
          class="max-h-scene w-full object-cover"
          fetchpriority="high"
        />
      </picture>
    )}
    {PACKS_ENABLED && scene.posterImage && imageQualification(scene.posterImage) && (
      <p class="bg-sheet px-6 pt-4 text-caption text-dim">{imageQualification(scene.posterImage)}</p>
    )}
    <div class="flex flex-wrap items-center justify-between gap-6 bg-sheet p-6">
      <div class="max-w-prose">
        <p>{stateCopy}</p>
        <p class="mt-2 text-sm text-dim">{scene.copy.devices}</p>
      </div>
      <button type="button" class="btn" data-explore hidden>
        Explore
      </button>
    </div>
  </div>
  <div
    data-active
    hidden
    class="fixed inset-0 z-50 flex flex-col overflow-auto bg-paper"
  >
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-rule p-4">
      <button type="button" class="btn btn-secondary" data-exit>
        Exit scene
      </button>
      {runtime && (
        <p class="flex flex-1 flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm text-dim">
          {!scene.available && <span>{scene.copy.previewLabel}</span>}
          {scene.links.map((link) => (
            <a href={`${scene.assetBase}${link.path}`}>{link.label}</a>
          ))}
        </p>
      )}
      <button type="button" class="btn btn-secondary" data-fullscreen>
        Enter fullscreen
      </button>
    </div>
    <p data-loading role="status" class="p-6">
      Loading the scene…
    </p>
    <div data-mount class="min-h-viewer flex-1"></div>
  </div>
  <template data-unavailable>
    <div class="flex min-h-viewer flex-col items-center justify-center gap-6 p-8 text-center">
      <h2 class="font-semibold">{scene.copy.unavailableTitle}</h2>
      <p class="max-w-prose text-lg">{scene.copy.unavailableBody}</p>
      <a class="btn btn-secondary" href={scene.fallback.href}>
        {scene.fallback.label}
      </a>
    </div>
  </template>
  <p data-status role="status" class="sr-only"></p>
  <noscript>
    <p class="bg-sheet p-6">
      JavaScript is required for interactive scenes.
    </p>
  </noscript>
</scene-shell>
<script>
  import { createIslandSession } from "./island-session";
  import type { SceneMountProps, SceneRuntimeModule } from "../scenes/types";

  /** A frame-kind runtime is a standalone page (scripts/scene-runtime.mjs) that reports through postMessage. */
  function mountFrame(container: HTMLElement, url: string, title: string, props: SceneMountProps) {
    const frame = document.createElement("iframe");
    frame.title = title;
    frame.className = "block h-full min-h-viewer w-full border-0";
    frame.setAttribute("allow", "fullscreen");
    const onMessage = (event: MessageEvent) => {
      if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
      const data = event.data as { source?: string; state?: string; text?: string; message?: string } | null;
      if (data?.source !== "kiln-scene") return;
      if (data.state === "progress") props.onProgress?.({ phase: "assets", loaded: 0, total: 0, text: data.text ?? "" });
      else if (data.state === "ready") {
        props.onReady?.();
        frame.contentWindow?.focus();
      } else if (data.state === "error") props.onError?.(new Error(data.message ?? "The scene could not start."));
    };
    window.addEventListener("message", onMessage);
    container.append(frame);
    frame.src = url;
    return () => {
      window.removeEventListener("message", onMessage);
      frame.remove();
    };
  }

  class SceneShell extends HTMLElement {
    private dispose?: () => void;
    connectedCallback() {
      const intro = this.querySelector<HTMLElement>("[data-intro]")!;
      const active = this.querySelector<HTMLElement>("[data-active]")!;
      const mount = this.querySelector<HTMLElement>("[data-mount]")!;
      const explore = this.querySelector<HTMLButtonElement>("[data-explore]")!;
      const exit = this.querySelector<HTMLButtonElement>("[data-exit]")!;
      const fullscreen =
        this.querySelector<HTMLButtonElement>("[data-fullscreen]")!;
      const status = this.querySelector<HTMLElement>("[data-status]")!;
      const loading = this.querySelector<HTMLElement>("[data-loading]")!;
      const unavailable =
        this.querySelector<HTMLTemplateElement>("[data-unavailable]")!;
      let contentReady = false;
      // data-scene-state is idle, loading, ready or error; data-scene-phase is the scene's
      // latest progress phase; data-scene-backend and data-scene-tier are what the scene reports.
      // All are read by the browser checks.
      const setState = (state: string) => {
        this.dataset.sceneState = state;
      };
      setState("idle");
      const ready = () => {
        if (active.hidden) return;
        contentReady = true;
        loading.hidden = true;
        status.textContent = "Scene ready.";
        setState("ready");
      };
      const progress = (update: { phase: string; text: string }) => {
        if (contentReady || active.hidden) return;
        this.dataset.scenePhase = update.phase;
        loading.textContent = update.text;
      };
      const inertElements: { element: HTMLElement; inert: boolean }[] = [];
      const background = (hide: boolean) => {
        if (!hide) {
          for (const { element, inert } of inertElements) element.inert = inert;
          inertElements.length = 0;
          return;
        }
        if (inertElements.length) return;
        let branch: HTMLElement = this;
        while (branch.parentElement) {
          for (const sibling of branch.parentElement.children) {
            if (
              sibling !== branch &&
              sibling instanceof HTMLElement &&
              !["SCRIPT", "STYLE", "LINK"].includes(sibling.tagName)
            ) {
              inertElements.push({ element: sibling, inert: sibling.inert });
              sibling.inert = true;
            }
          }
          if (branch.parentElement === document.body) break;
          branch = branch.parentElement;
        }
      };
      const fail = (error?: Error) => {
        session.stop();
        status.classList.remove("sr-only");
        status.classList.add("p-6");
        status.textContent =
          this.dataset.errorText ??
          "The scene could not load. Check your connection and try Explore again.";
        this.dataset.sceneError =
          (error as { code?: string } | undefined)?.code ?? "runtime";
        setState("error");
        explore.focus();
      };
      const session = createIslandSession(
        async () => {
          const props: SceneMountProps = {
            assetBase: this.dataset.assetBase!,
            onReady: ready,
            onProgress: progress,
            onBackend: (backend) => {
              this.dataset.sceneBackend = backend.backend;
            },
            onTier: (change) => {
              const tier = change.tier ?? change.suggestedTier;
              if (change.kind !== "advice" && tier) this.dataset.sceneTier = tier;
            },
            // The scene may report a fatal error from inside React's commit; leave it first.
            onError: (error) => queueMicrotask(() => fail(error)),
          };
          const url = this.dataset.runtimeUrl;
          if (this.dataset.kind === "module" && url) {
            const runtime = (await import(/* @vite-ignore */ url)) as SceneRuntimeModule;
            return runtime.mount(mount, props);
          }
          if (this.dataset.kind === "frame" && url) {
            return mountFrame(mount, url, this.dataset.frameTitle ?? `${this.dataset.scene} scene`, props);
          }
          // No runtime in this build: state the status in place of the scene.
          mount.append(unavailable.content.cloneNode(true));
          queueMicrotask(() => props.onReady?.());
          return () => mount.replaceChildren();
        },
        (state, error) => {
          const showing = state === "loading" || state === "ready";
          if (state === "loading") {
            contentReady = false;
            loading.textContent = "Loading the scene…";
            delete this.dataset.scenePhase;
            delete this.dataset.sceneError;
            delete this.dataset.sceneBackend;
            delete this.dataset.sceneTier;
            setState("loading");
          }
          if (state === "idle") setState("idle");
          loading.hidden = !showing || contentReady;
          background(showing);
          intro.hidden = showing;
          active.hidden = !showing;
          status.classList.add("sr-only");
          status.classList.remove("p-6");
          status.textContent = "";
          if (state === "error") fail(error);
          if (state === "loading") exit.focus();
        },
      );
      const leave = () => {
        session.stop();
        if (document.fullscreenElement === this)
          void document.exitFullscreen().catch(() => {});
        explore.focus();
      };
      const start = () => void session.start();
      const toggleFullscreen = async () => {
        try {
          if (document.fullscreenElement === this)
            await document.exitFullscreen();
          else await this.requestFullscreen();
          loading.hidden = contentReady;
        } catch {
          loading.hidden = false;
          loading.textContent =
            "Fullscreen is unavailable in this browser. You can continue in the page.";
        }
      };
      const syncFullscreen = () => {
        fullscreen.textContent =
          document.fullscreenElement === this
            ? "Leave fullscreen"
            : "Enter fullscreen";
      };
      const onKey = (event: KeyboardEvent) => {
        if (
          event.key === "Escape" &&
          !document.fullscreenElement &&
          !active.hidden
        )
          leave();
      };
      const onPageHide = () => session.stop();
      fullscreen.hidden = !document.fullscreenEnabled;
      explore.hidden = false;
      explore.addEventListener("click", start);
      exit.addEventListener("click", leave);
      fullscreen.addEventListener("click", toggleFullscreen);
      this.addEventListener("keydown", onKey);
      document.addEventListener("fullscreenchange", syncFullscreen);
      window.addEventListener("pagehide", onPageHide);
      this.dispose = () => {
        session.stop();
        explore.removeEventListener("click", start);
        exit.removeEventListener("click", leave);
        fullscreen.removeEventListener("click", toggleFullscreen);
        this.removeEventListener("keydown", onKey);
        document.removeEventListener("fullscreenchange", syncFullscreen);
        window.removeEventListener("pagehide", onPageHide);
      };
    }
    disconnectedCallback() {
      this.dispose?.();
    }
  }
  if (!customElements.get("scene-shell"))
    customElements.define("scene-shell", SceneShell);
</script>

---
import { bytes } from '../lib/catalog';
import { buildDownloadChoices, type DownloadFile } from '../lib/download-choices';
interface Props { runtime: DownloadFile; editable: DownloadFile }
const { runtime, editable } = Astro.props;
const choices = buildDownloadChoices(runtime, editable);
---
<div class="mt-6 grid gap-6 md:grid-cols-2" data-asset-downloads>
  {choices.map(choice => <article class="border-y border-rule py-5">
    <h3 class="text-title">{choice.label}</h3>
    <p class="mt-3 max-w-reading text-dim">{choice.description}</p>
    <p class="mt-3 font-mono text-code">{bytes(choice.bytes)}</p>
    <a class="btn btn-secondary mt-5" href={choice.url} data-download-profile={choice.profile}>Download {choice.label.toLowerCase()} <span aria-hidden="true">↓</span></a>
  </article>)}
</div>

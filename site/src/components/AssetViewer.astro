---
interface Props {
  name: string;
  modelUrl: string;
  poster: string;
  posterAlt?: string;
  /** The poster file's own pixel size, as the build recorded it: there is no default. */
  posterWidth: number;
  posterHeight: number;
  srcsetWebp?: string;
  srcsetAvif?: string;
  /** The frame behind the poster: the site backdrop, or a poster's own baked background colour (archive renders). */
  frameClass?: string;
  /** Exact allowlisted Vehicles catalog ID; omitted on all other assets. */
  paintAssetId?: string;
}
const {
  name,
  modelUrl,
  poster,
  posterAlt = `${name}, rendered from the downloadable revision`,
  posterWidth,
  posterHeight,
  srcsetWebp,
  srcsetAvif,
  frameClass = "bg-backdrop",
  paintAssetId,
} = Astro.props;
// A single-file poster has no candidates to choose from, so it declares no sizes.
const sizes = srcsetWebp || srcsetAvif ? "(max-width: 768px) 100vw, 70vw" : undefined;
---

<asset-viewer
  data-name={name}
  data-model={modelUrl}
  data-paint-asset={paintAssetId}
  class:list={["block border border-rule", frameClass]}
>
  <div data-poster>
    <picture>
      {srcsetAvif && (
        <source
          type="image/avif"
          srcset={srcsetAvif}
          sizes={sizes}
        />
      )}
      <img
        src={poster}
        srcset={srcsetWebp}
        sizes={sizes}
        width={posterWidth}
        height={posterHeight}
        alt={posterAlt}
        class="block aspect-square max-h-viewer w-full object-contain"
        fetchpriority="high"
      />
    </picture>
  </div>
  <div class="flex flex-wrap items-center gap-4 border-t border-rule bg-sheet p-4">
    <button type="button" data-open hidden class="btn">
      Open 3D view
    </button>
    <button type="button" data-close hidden class="btn btn-secondary">
      Close 3D view
    </button>
    <p data-status role="status" class="text-caption text-dim">
      Drag to orbit after opening. The model starts stationary.
    </p>
  </div>
  <div data-mount hidden class="min-h-viewer"></div>
  <noscript>
    <p class="p-4">
      Enable JavaScript to inspect the model in 3D. The poster, source and
      downloads remain available.
    </p>
  </noscript>
</asset-viewer>
<script>
  import { createIslandSession } from "./island-session";
  import { viewerErrorMessage } from "./viewer-retry";
  class AssetViewerElement extends HTMLElement {
    private stop?: () => void;
    connectedCallback() {
      const open = this.querySelector<HTMLButtonElement>("[data-open]")!;
      const close = this.querySelector<HTMLButtonElement>("[data-close]")!;
      const poster = this.querySelector<HTMLElement>("[data-poster]")!;
      const mount = this.querySelector<HTMLElement>("[data-mount]")!;
      const status = this.querySelector<HTMLElement>("[data-status]")!;
      const session = createIslandSession(
        async () => {
          if (import.meta.env.DEV)
            await import("@vitejs/plugin-react/preamble");
          const { mountAssetViewer } = await import("./AssetViewerRuntime");
          return mountAssetViewer(mount, {
            name: this.dataset.name!,
            modelUrl: this.dataset.model!,
            paintAssetId: this.dataset.paintAsset,
            onError: (error) => {
              session.stop();
              status.textContent = viewerErrorMessage(error);
              open.focus();
            },
          });
        },
        (state, error) => {
          const showing = state === "loading" || state === "ready";
          mount.hidden = !showing;
          poster.hidden = showing;
          open.hidden = showing;
          close.hidden = !showing;
          status.textContent =
            state === "error"
              ? viewerErrorMessage(error)
              : state === "loading"
                ? "Loading the 3D viewer…"
                : showing
                  ? "Drag to orbit. Scroll or pinch to zoom. Keyboard controls are below the model."
                  : "Drag to orbit after opening. The model starts stationary.";
          if (state === "loading") close.focus();
          if (state === "error") open.focus();
        },
      );
      const start = () => void session.start();
      const stop = () => {
        session.stop();
        open.focus();
      };
      const onPageHide = () => session.stop();
      open.hidden = false;
      open.addEventListener("click", start);
      close.addEventListener("click", stop);
      window.addEventListener("pagehide", onPageHide);
      this.stop = () => {
        session.stop();
        open.removeEventListener("click", start);
        close.removeEventListener("click", stop);
        window.removeEventListener("pagehide", onPageHide);
      };
    }
    disconnectedCallback() {
      this.stop?.();
    }
  }
  if (!customElements.get("asset-viewer"))
    customElements.define("asset-viewer", AssetViewerElement);
</script>

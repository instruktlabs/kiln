---
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import AssetCard from "../../components/AssetCard.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import VehiclesPack from "../../components/VehiclesPack.astro";
import FoundryFloorPack from "../../components/FoundryFloorPack.astro";
import { farm, vehicles, bytes, imageQualification, packSlugs, FULL_WIDTH_IMAGE_SIZES } from "../../lib/catalog";
import { PACKS_ENABLED, REPO } from "../../lib/config";
import foundryFloor from "../../data/foundry-floor.json";
import { sceneRuntimes } from "virtual:kiln-scenes";
export function getStaticPaths() {
  return packSlugs(PACKS_ENABLED).map((slug) => ({
    params: { slug },
  }));
}
const isFarm = Astro.params.slug === "farm";
const isVehicles = Astro.params.slug === "vehicles";
const title = isFarm ? farm.name : isVehicles ? vehicles.name : foundryFloor.name;
const pageTitle = isFarm || isVehicles ? title : `${title}, in production`;
const qualificationNote =
  "qualification" in farm &&
  farm.qualification &&
  typeof farm.qualification === "object" &&
  "note" in farm.qualification &&
  typeof farm.qualification.note === "string"
    ? farm.qualification.note
    : undefined;
---

<BaseLayout
  title={`${pageTitle} — Kiln Commons`}
  description={
    isFarm
      ? "23 farm assets with runtime GLBs, editable source and a runnable scene. Exact delivery downloads, provenance and owner review status."
      : isVehicles
        ? "Six generic road vehicles with three detail tiers, separate wheels, editable source and revision history. Exact downloads, provenance and owner review status."
        : `${foundryFloor.name} is in production: ${foundryFloor.summary}.`
  }
  noindex={!isFarm && !isVehicles}
  breadcrumbs={[
    { label: "Packs", href: "/packs/" },
    { label: title, href: `/packs/${Astro.params.slug}/` },
  ]}
  card={isFarm ? "farm" : isVehicles ? "vehicles" : "foundry-floor"}
  preloadImage={
    isFarm
      ? {
          src: farm.scene.poster.src,
          srcset: farm.scene.poster.srcsetAvif,
          sizes: FULL_WIDTH_IMAGE_SIZES,
        }
      : undefined
  }
  jsonLd={
    isFarm
      ? {
          "@context": "https://schema.org",
          "@type": "CollectionPage",
          name: farm.name,
          description: farm.description,
          url: "https://kilnstudio.tools/packs/farm/",
        }
      : isVehicles
        ? {
            "@context": "https://schema.org",
            "@type": "CollectionPage",
            name: vehicles.name,
            description: vehicles.description,
            url: "https://kilnstudio.tools/packs/vehicles/",
          }
        : undefined
  }
>
  <div class="container">
    {isFarm ? (
      <>
        <div class="grid items-start gap-6 py-8 lg:grid-cols-2">
          <PageHeader>Shapes &amp; Seasons Farm</PageHeader>
          <p class="lead">
            A low-poly farm built from 23 assets, from a shuttered farmhouse and
            working mills to animals, crops and timber fencing. Every asset has
            its source and provenance.
          </p>
        </div>
        <figure class="mt-4">
          <ResponsiveImage image={farm.scene.poster} eager sizes={FULL_WIDTH_IMAGE_SIZES} />
          <figcaption class="mt-3 font-mono text-code text-dim">
            The downloadable Farm scene · {farm.revision} documented delivery ·{" "}
            {farm.assetCount} assets / {farm.materialRecords} material records /{" "}
            {farm.textureMaps} texture maps
            {imageQualification(farm.scene.poster) && (
              <span class="mt-2 block">{imageQualification(farm.scene.poster)}</span>
            )}
          </figcaption>
        </figure>
        <div class="mt-8 grid gap-6 border-y border-ink py-6 md:grid-cols-2">
          <p class="max-w-reading">
            <strong>
              {farm.ownerReview.acceptedAssets} of {farm.ownerReview.total}{" "}
              current revisions have owner approval.
            </strong>{" "}
            The owner accepted the wood-floor farmhouse on 29 September 2026.
            The sealed {farm.deliveryReview.revision} package records{" "}
            <code>
              fullPackAccepted: {String(farm.deliveryReview.fullPackAccepted)}
            </code>
            .{" "}
            {farm.assets[0]!.revisionId === farm.floorRevision.asset.revisionId
              ? "This delivery includes the accepted floor."
              : "It contains the earlier farmhouse; owner acceptance of the child revision does not change the sealed record."}
            {" "}{qualificationNote}
          </p>
          <div>
            <p class="max-w-reading">
              {farm.scene.available
                ? "Explore the Farm in your browser."
                : sceneRuntimes.farm
                  ? "The current browser scene is available for owner review. The scene download below contains the same controls and asset revisions."
                  : "The interactive scene is not included in this site build. The scene download below contains the current runnable scene."}
            </p>
            <a class="text-link" href="/scenes/farm/">
              {farm.scene.available
                ? "Explore the Farm"
                : sceneRuntimes.farm
                  ? "View the scene preview"
                  : "View the scene status"} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <section class="pt-16" aria-labelledby="downloads">
          <h2 id="downloads">Download the profile you need.</h2>
          <p class="mt-4 max-w-reading text-dim">
            All three files are from the sealed {farm.revision} documented
            package. Each archive contains a <code>delivery.json</code>{" "}
            inventory with member hashes.
          </p>
          <div class="mt-8 border-t border-ink">
            {farm.downloads.map((download) => (
              <article class="grid gap-5 border-b border-rule py-7 lg:grid-cols-12">
                <div class="lg:col-span-2">
                  <h3 class="text-title capitalize">{download.profile}</h3>
                  <p class="mt-2 font-mono text-code">
                    {bytes(download.bytes)}
                  </p>
                </div>
                <div class="lg:col-span-7">
                  <ul class="list-disc space-y-1 pl-5">
                    {download.contents.map((content) => (
                      <li>{content}</li>
                    ))}
                  </ul>
                  <p class="mt-3 max-w-reading text-caption text-dim">
                    {download.compatibility}
                  </p>
                  <details class="mt-3 border border-rule">
                    <summary class="font-mono text-code">SHA-256</summary>
                    <p class="break-all px-4 pb-4 font-mono text-code">
                      {download.sha256}
                    </p>
                  </details>
                </div>
                <div class="lg:col-span-3 lg:text-right">
                  <a class="btn btn-secondary" href={download.url}>
                    Download {download.profile}{" "}
                    <span aria-hidden="true">↓</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
        <section class="pt-16" aria-labelledby="scene">
          <div class="grid gap-8 lg:grid-cols-2">
            <div>
              <h2 id="scene">The scene is a place to try the pack.</h2>
              <p class="mt-5 max-w-reading">
                On desktop, walk in first person as Rowan, open doors and gates,
                cross the bridge and drive the tractor. Click to capture the
                mouse while walking; Escape releases it and returns to overview.
                The browser preview on
                the{" "}
                <a class="text-link" href="/scenes/farm/">Farm scene page</a>{" "}
                and the scene download both include joystick movement, drag-look
                and contextual touch controls. Pinch zoom is available in
                overview and tractor driving; walking keeps a fixed eye height.
              </p>
              <p class="mt-4 max-w-reading text-dim">
                Trailer towing and general vehicle physics are not included.
                The scene uses Three.js 0.186.0 with WebGPU and a WebGL2 fallback.
                Current checks cover desktop and emulated touch on both backends;
                this revision has no physical-device performance qualification.
              </p>
            </div>
            <div class="min-w-0">
              <h3 class="text-title">Run the downloaded scene</h3>
              <p class="my-4">
                Extract the scene archive, then run this from the extracted
                directory. Open the loopback URL it prints.
              </p>
              <CodeBlock
                code="node scene/serve.mjs --verify"
                lang="bash"
                label="Serve the Farm locally"
              />
              <p class="mt-3 text-caption text-dim">
                Viewing needs no npm install, model account or Kiln render
                service. Customize a copy with a development server; the
                this command checks the sealed asset files before serving them.
              </p>
            </div>
          </div>
        </section>
        <section class="pt-16" aria-labelledby="inventory">
          <h2 id="inventory">Every asset can be used on its own.</h2>
          <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4">
            {farm.assets.map((asset) => (
              <AssetCard asset={asset} />
            ))}
          </div>
        </section>
        <section class="pt-16" aria-labelledby="authorship">
          <h2 id="authorship">Authorship stays with each revision.</h2>
          <p class="mt-5 max-w-reading">
            The original Farm runs requested high effort, independently
            confirmed for GPT-6 Astra and unconfirmed for Claude Opus 5.5 and
            Gemini 3.8 Flash High. The new farmer hand refinement requested ultra
            effort; independent confirmation is not recorded. Each revision
            below retains its own authoring record.
          </p>
          <div class="mt-8 border-t border-ink">
            {farm.assets.map((asset) => (
              <details class="border-b border-rule">
                <summary class="flex-wrap font-semibold">
                  {asset.name} · {asset.provenance.originalModel}
                </summary>
                <div class="px-4 pb-6">
                  <ol class="space-y-5">
                    {asset.revisions.map((revision) => (
                      <li class="grid gap-2 md:grid-cols-2">
                        <div>
                          <p>
                            {revision.model} ·{" "}
                            <code>
                              {revision.harness}{" "}
                              {revision.harnessVersion ??
                                "version not recorded"}
                            </code>
                          </p>
                          <p class="mt-1 text-caption text-dim">
                            Requested effort:{" "}
                            {revision.requestedEffort ?? "not recorded"}.
                            Independently confirmed:{" "}
                            {revision.confirmedEffort ?? "not recorded"}.
                          </p>
                        </div>
                        <div>
                          <p class="break-all font-mono text-code">
                            {revision.revisionId}
                          </p>
                          <p class="mt-1 text-caption text-dim">
                            {revision.stage}
                          </p>
                        </div>
                      </li>
                    ))}
                  </ol>
                  {asset.id === "farmhouse" && (
                    <p class="mt-5 max-w-reading text-dim">
                      The wood-floor child was refined by Gemini 3.8 Flash High
                      via agy after the r33 revision. High effort was requested,
                      not independently confirmed. The owner accepted the child
                      on 29 September 2026.
                    </p>
                  )}
                  <a href={`/gallery/${asset.slug}/`} class="text-link mt-3">
                    Source and revision details <span aria-hidden="true">→</span>
                  </a>
                </div>
              </details>
            ))}
          </div>
        </section>
        <section class="pt-16" aria-labelledby="license">
          <h2 id="license">Keep the licence boundary intact.</h2>
          <p class="mt-5 max-w-reading" data-verbatim>{farm.licenseScope}</p>
          <p class="mt-4 max-w-reading">
            Preserve <code>licenses/</code>,{" "}
            <code>metadata/materials.json</code> and the scene software notices.
            Rebuilding editable assets requires installing the locked npm
            dependencies; the kit does not contain every third-party archive for
            a fully offline install.
          </p>
          <a
            class="text-link mt-2"
            href="https://creativecommons.org/publicdomain/zero/1.0/"
          >
            CC0-1.0 dedication <span aria-hidden="true">↗</span>
          </a>
        </section>
      </>
    ) : isVehicles ? (
      <VehiclesPack />
    ) : PACKS_ENABLED ? (
      <FoundryFloorPack />
    ) : (
      <div class="max-w-reading py-12 md:py-20">
        <PageHeader>{foundryFloor.name}</PageHeader>
        <p class="lead mt-8">In production.</p>
        <p class="mt-6">
          A fictional 2 nm-class chip fab as a Kiln pack: process tools, wafer
          transport and a scene where the factory runs.
        </p>
        <p class="mt-4 text-dim">
          This build does not carry the pack’s models or downloads.
        </p>
        <p class="mt-4">{foundryFloor.notice}</p>
        <a href={REPO} class="text-link mt-6">
          Follow the repository <span aria-hidden="true">↗</span>
        </a>
      </div>
    )}
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ScenePoster from '../../components/ScenePoster.astro';
import { bytes, type CatalogImage } from '../../lib/catalog';
import { PACKS_ENABLED } from '../../lib/config';
import cabinWoods from '../../data/cabin-woods-psx-horror.json';
import { cabinWoodsAssets, cabinWoodsHref, cabinWoodsTextureResources } from '../../lib/cabin-woods';
type PackDownload = { profile: 'runtime' | 'editable' | 'scene'; label: string; url: string; bytes: number; sha256: string };
const downloads = PACKS_ENABLED ? cabinWoods.downloads as PackDownload[] : [];
const assets = PACKS_ENABLED ? cabinWoodsAssets : [];
const posters = PACKS_ENABLED ? cabinWoods.posters as CatalogImage[] : [];
const textureResources = PACKS_ENABLED ? cabinWoodsTextureResources : [];
---
<BaseLayout title={`${cabinWoods.name} asset pack · Kiln`} description="53 low-poly cabin and forest assets with runtime GLBs, editable Kiln source and procedural pixel materials." breadcrumbs={[{ label: 'Packs', href: '/packs/' }, { label: `${cabinWoods.name} asset pack`, href: '/packs/cabin-woods-psx-horror/' }]} card="packs">
  <div class="container py-8">
    <PageHeader>{cabinWoods.name}</PageHeader>
    <p class="lead mt-6">{cabinWoods.description}</p>
    <a class="btn mt-6" href="/scenes/cabin-woods-psx-horror/">Open the scene preview</a>
    {posters.length > 0 && <div class="mt-8"><ScenePoster images={posters} sizes="(max-width: 767px) calc(100vw - 2rem), 81rem" eager /></div>}
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div><h2 class="text-subheading">Reusable cabin and forest assets.</h2><p class="mt-3">Cabin structure and furnishings, workyard equipment, tools and weapons, pine and birch trees, woodland vegetation, a Stone Golem and an articulated spider. Original low-poly geometry and procedural pixel materials.</p></div>
      <div><h2 class="text-subheading">Choose the delivery profile.</h2><p class="mt-3">Runtime files contain GLBs and metadata. Editable files include source and exact material dependencies. The scene profile contains the runnable demonstration and its software notices. {cabinWoods.devices}</p></div>
    </div>
    <h2 class="text-subheading mt-12">Downloads</h2>
    <p class="mt-3">For Full Kiln assets, extract the pack, then import the individual revision ZIPs under <code>revisions/</code> with <code>node kiln.mjs import path/to/revision.zip</code>. The runnable scene archive includes its own setup instructions.</p>
    <p class="mt-3 text-sm text-dim">Full Kiln assets require an importing Kiln build that supports the included material schemas. Use Kiln 1.2.3 or later. Runtime GLBs do not require Kiln.</p>
    {downloads.length ? <div class="mt-4 overflow-x-auto"><table class="w-full text-left"><thead><tr><th class="p-3">Profile</th><th class="p-3">Size</th><th class="p-3">SHA-256</th></tr></thead><tbody>{downloads.map(download => <tr class="border-t border-rule"><td class="p-3"><a class="text-link" href={download.url}>{download.label}</a></td><td class="p-3 whitespace-nowrap">{bytes(download.bytes)}</td><td class="p-3 break-all font-mono text-xs">{download.sha256}</td></tr>)}</tbody></table></div> : <p class="mt-3">Verified download files are not staged in this build.</p>}
    {assets.length > 0 && <div class="mt-12"><h2 class="text-subheading">Models ({assets.length})</h2><ul class="mt-4 grid gap-3 md:grid-cols-3">{assets.map(asset => <li><a class="text-link" href={cabinWoodsHref(asset)}>{asset.name}</a><span class="block text-sm text-dim">{asset.category}</span></li>)}</ul></div>}
    {textureResources.length > 0 && <div class="mt-10"><h2 class="text-subheading">Reusable ground materials</h2><ul class="mt-4 flex flex-wrap gap-6">{textureResources.map(resource => <li><a class="text-link" href={resource.editableDownload.url}>{resource.label}: full Kiln material</a></li>)}</ul><p class="mt-3 text-sm text-dim">These are texture resources, not dummy meshes. Import with <code>node kiln.mjs material import --file material.kiln.json</code> to reuse their pixels and editable recipes.</p></div>}
    <p class="mt-8 text-sm text-dim">Keep the supplied asset licences, material provenance and scene software notices with the files. A successful preview does not establish support in every destination engine.</p>
  </div>
</BaseLayout>

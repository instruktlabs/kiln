---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import AssetCard from '../../../components/AssetCard.astro';
import { bytes } from '../../../lib/catalog';
import { PACKS_ENABLED, SITE } from '../../../lib/config';
import { holodeck, holodeckAssetHref, holodeckAssets, holodeckPackHref, holodeckPacks, holodeckWorldUrl, type HolodeckPack } from '../../../lib/holodeck';

export function getStaticPaths() {
  return PACKS_ENABLED ? holodeckPacks.map(pack => ({ params: { scene: pack.scene }, props: { pack } })) : [];
}
interface Props { pack: HolodeckPack; }
const { pack } = Astro.props;
const assets = pack.assets.map(slug => holodeckAssets.find(asset => asset.slug === slug)).filter(asset => asset !== undefined);
const worldUrl = holodeckWorldUrl(pack.id);
const href = holodeckPackHref(pack);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${pack.name} asset pack`,
  description: pack.description,
  url: new URL(href, SITE).href,
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  about: { '@type': 'CreativeWork', name: `${pack.name}, a walkable Holodeck scene`, url: worldUrl },
  hasPart: assets.map(asset => ({ '@type': '3DModel', name: asset.name, url: new URL(holodeckAssetHref(asset), SITE).href })),
};
---
<BaseLayout title={`${pack.name} asset pack · Holodeck · Kiln`} description={`${pack.assetCount} Kiln assets from the Holodeck ${pack.name} scene, with runtime GLBs, editable Kiln source and a link to walk the scene.`} breadcrumbs={[{ label: 'Packs', href: '/packs/' }, { label: `${pack.name} asset pack`, href }]} card="packs" jsonLd={schema} noindex={!pack.available}>
  <div class="container py-8">
    <PageHeader>{pack.name}</PageHeader>
    <p class="lead mt-6">{pack.description}</p>
    <a class="btn mt-6" href={worldUrl}>Walk {pack.name} on Holodeck <span aria-hidden="true">↗</span></a>
    {pack.sceneStillPlacesEarlier?.length ? <p class="mt-4 max-w-reading text-dim">This pack holds the final Cove modules. The walkable {pack.name} scene still places their earlier versions until that world is updated.</p> : null}
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div><h2 class="text-subheading">Every Kiln asset in the scene.</h2><p class="mt-3">The pack holds the final version of each of the scene’s {pack.assetCount} Kiln assets, each with its runtime GLB and its editable Kiln source.</p></div>
      <div><h2 class="text-subheading">Choose the delivery profile.</h2><p class="mt-3">Runtime files contain GLBs and Kiln metadata sidecars and need no Kiln install. Full Kiln assets are standard revision bundles you can import and remix.</p></div>
    </div>
    <h2 class="text-subheading mt-12">Downloads</h2>
    <p class="mt-3">For Full Kiln assets, extract the pack, then import the revision ZIPs under <code>revisions/</code> with <code>node kiln.mjs import path/to/revision.zip</code>. Use Kiln 1.4.0 or later. Runtime GLBs do not require Kiln.</p>
    <div class="mt-4 overflow-x-auto"><table class="w-full text-left"><thead><tr><th class="p-3">Profile</th><th class="p-3">Size</th><th class="p-3">SHA-256</th></tr></thead><tbody>{pack.downloads.map(download => <tr class="border-t border-rule"><td class="p-3"><a class="text-link" href={download.url}>{download.label}</a></td><td class="p-3 whitespace-nowrap">{bytes(download.bytes)}</td><td class="p-3 break-all font-mono text-xs">{download.sha256}</td></tr>)}</tbody></table></div>
    {assets.length > 0 && <div class="mt-12"><h2 class="text-subheading">Models ({assets.length})</h2><div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4">{assets.map(asset => <AssetCard asset={{ ...asset, href: holodeckAssetHref(asset) }} />)}</div></div>}
    <p class="mt-8 text-sm text-dim">Asset content is dedicated {holodeck.licence.spdx}; keep the supplied licence files with the assets. Kiln and Holodeck software keep their own licences.</p>
  </div>
</BaseLayout>

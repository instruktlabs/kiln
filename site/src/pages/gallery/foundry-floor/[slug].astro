---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import AssetViewer from "../../../components/AssetViewer.astro";
import EngineNote from "../../../components/EngineNote.astro";
import { readGlbFacts } from "../../../../scripts/engine-note.mjs";
import { resolve } from "node:path";
import StatRow from "../../../components/StatRow.astro";
import { foundry, foundryGalleryAssets, type FoundryAsset } from "../../../lib/gallery";
import { bytes, bounds, number } from "../../../lib/catalog";
import foundryInfo from "../../../data/foundry-floor.json";

export function getStaticPaths() {
  return foundryGalleryAssets.map((asset) => ({ params: { slug: asset.slug }, props: { asset } }));
}
interface Props { asset: FoundryAsset }
const { asset } = Astro.props;
const group = foundry.groups.find((group) => group.id === asset.group)!;
const modelUrl = `${foundry.scenePack.base}${asset.runtimeDownload.member}`;
const modelFacts = await readGlbFacts(resolve("public", modelUrl.replace(/^\//, "")));
const description = `${asset.name}: a ${group.title.toLowerCase()} model from Foundry Floor. Inspect the delivered GLB, saved revision, dimensions and animation clips.`;
---

<BaseLayout title={`${asset.name} · Foundry Floor · Kiln`} description={description}
  breadcrumbs={[{ label: "Gallery", href: "/gallery/" }, { label: asset.name, href: `/gallery/foundry-floor/${asset.slug}/` }]}
  noindex card="foundry-floor">
  <div class="container">
    <div class="grid gap-6 py-8 lg:grid-cols-2">
      <div><PageHeader>{asset.name}</PageHeader><p class="mt-4 max-w-reading">{description}</p></div>
      <p class="font-mono text-code lg:text-right"><a class="text-link" href="/packs/foundry-floor/">Foundry Floor</a> · {group.title}</p>
    </div>
    <p class="mb-6 max-w-reading"><strong>In production.</strong> This saved revision is awaiting owner review.</p>
    <div class="drawing-sheet">
      <AssetViewer name={asset.name} modelUrl={`${modelUrl}?revision=${encodeURIComponent(asset.revisionId)}`}
        poster={asset.poster.src} posterAlt={asset.poster.alt} posterWidth={asset.poster.width}
        posterHeight={asset.poster.height} srcsetWebp={asset.poster.srcsetWebp} srcsetAvif={asset.poster.srcsetAvif} />
    </div>
    <EngineNote extensions={modelFacts.extensionsUsed} />
    <StatRow values={[
      { label: "Default draw", value: `${number(asset.metrics.triangles)} triangles` },
      { label: "Materials", value: asset.metrics.materials },
      { label: "Animation clips", value: asset.metrics.clips.length },
    ]} />
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn" href={asset.runtimeDownload.url}>Download GLB <span aria-hidden="true">↓</span></a>
      <a class="btn btn-secondary" href="/scenes/foundry-floor/">Explore the scene</a>
      <a class="btn btn-secondary" href="/packs/foundry-floor/">View the full pack</a>
    </div>
    <p class="mt-3 font-mono text-code text-dim">{bytes(asset.runtimeDownload.bytes)} · CC0-1.0 authored asset content</p>
    <section class="pt-12" aria-labelledby="model-details">
      <h2 id="model-details">Model details</h2>
      <dl class="mt-6 divide-y divide-rule border-y border-ink">
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Saved revision</dt><dd class="break-all font-mono text-code md:col-span-2">{asset.revisionId}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Dimensions</dt><dd class="md:col-span-2">{bounds(asset.metrics.bounds)} m (X × Y × Z)</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Recorded author</dt><dd class="md:col-span-2">{asset.author}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Animation</dt><dd class="md:col-span-2">{asset.metrics.clips.length ? asset.metrics.clips.join(", ") : "No animation clips."}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">GLB SHA-256</dt><dd class="break-all font-mono text-code md:col-span-2">{asset.runtimeDownload.sha256}</dd></div>
      </dl>
      {asset.lod && <p class="mt-4 max-w-reading">This file includes optional LOD tiers. The web preview shows the default detailed form; application support for selecting other tiers varies.</p>}
      {asset.hideByDefault.length > 0 && <p class="mt-4 max-w-reading">The Foundry scene hides these included parts: {asset.hideByDefault.join(", ")}. A plain importer or this web preview may show them. The download preserves the authored contents.</p>}
      <p class="mt-4 max-w-reading"><a class="text-link" href="/docs/engine-handoff/">Blender and Unity import guidance</a> covers tested LOD, visibility and animation behavior.</p>
      <p class="mt-4 max-w-reading">{foundry.conventions.source}</p>
    </section>
    <section class="py-12" aria-labelledby="asset-license">
      <h2 id="asset-license">Licence and attribution</h2>
      <p class="mt-4 max-w-reading" data-verbatim>{foundry.licenseScope}</p>
      <p class="mt-4 max-w-reading">Keep the <a class="text-link" href={asset.licence.url}>pack licence</a> with the model. It records this revision and the GLB hash shown above.</p>
      <p class="mt-6 max-w-reading text-caption text-dim">{foundryInfo.notice}</p>
    </section>
  </div>
</BaseLayout>

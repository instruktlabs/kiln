---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { workbenchContrast } from "../../lib/shiki-contrast";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AssetViewer from "../../components/AssetViewer.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import {
  assets,
  farm,
  bridge,
  number,
  bounds,
  bytes,
  imageQualification,
  type CatalogAsset,
} from "../../lib/catalog";
export function getStaticPaths() {
  return assets.map((asset) => ({
    params: { slug: asset.slug },
    props: { asset },
  }));
}
interface Props {
  asset: CatalogAsset;
}
const { asset } = Astro.props;
const isBridge = asset.id === "golden-gate-bridge";
const source = await readFile(
  resolve("public", asset.sourcePath.slice(1)),
  "utf8",
);
const reference = isBridge
  ? (
      await (
        await createMarkdownProcessor({
          shikiConfig: { theme: "github-light", transformers: [workbenchContrast] },
        })
      ).render(
        await readFile(
          resolve("src/data/standalone/golden-gate-reference.md"),
          "utf8",
        ),
      )
    ).code.replace(
      /<a\b[^>]*href="(?!https?:|#)[^"]*"[^>]*>([\s\S]*?)<\/a>/g,
      "$1 (recorded local reference)",
    )
  : "";
const cleanReference = reference.replace(/ align="(?:left|right|center)"/g, "");
const description = `${asset.description} ${number(asset.metrics.triangles)} triangles, exact source and GLB, with revision history and review status.`;
const schema = {
  "@context": "https://schema.org",
  "@type": "3DModel",
  name: asset.name,
  description: asset.description,
  license: "https://creativecommons.org/publicdomain/zero/1.0/",
  url: `https://kilnstudio.tools/gallery/${asset.slug}/`,
  image: `https://kilnstudio.tools${asset.poster.src}`,
  encoding: {
    "@type": "MediaObject",
    contentUrl: asset.runtimeDownload.url,
    encodingFormat: "model/gltf-binary",
    contentSize: String(asset.runtimeDownload.bytes),
  },
};
---

<BaseLayout
  title={`${asset.name} — source and 3D model | Kiln`}
  description={description}
  breadcrumbs={[
    { label: "Gallery", href: "/gallery/" },
    { label: asset.name, href: `/gallery/${asset.slug}/` },
  ]}
  ogImage={`/social/${asset.slug}.webp`}
  jsonLd={schema}
  preloadImage={{
    src: asset.poster.src,
    srcset: asset.poster.srcsetAvif,
    sizes: "(max-width: 768px) 100vw, 70vw",
  }}
>
  <div class="container">
    <div class="flex flex-wrap items-end justify-between gap-4 py-6">
      <div>
        <h1>{asset.name}</h1>
        <p class="mt-4 max-w-reading">{asset.description}</p>
      </div>
      <p class="font-mono text-code">
        {asset.pack ? (
          <a href="/packs/farm/" class="text-ember underline">
            Shapes &amp; Seasons Farm
          </a>
        ) : (
          "Standalone"
        )}{" "}
        · {asset.category}
      </p>
    </div>
    <div class="drawing-sheet mt-4">
      <AssetViewer
        name={asset.name}
        modelUrl={`${asset.modelPath}?revision=${encodeURIComponent(asset.revisionId)}`}
        poster={asset.poster.src}
        posterAlt={asset.poster.alt}
        posterWidth={asset.poster.width}
        posterHeight={asset.poster.height}
        srcsetWebp={asset.poster.srcsetWebp}
        srcsetAvif={asset.poster.srcsetAvif}
      />
      <div class="grid gap-4 border-t border-ink bg-sheet px-5 py-4 sm:grid-cols-2">
        <p class="break-all font-mono text-code">Revision {asset.revisionId}</p>
        <p class="font-mono text-code sm:text-right">
          {isBridge
            ? "Metres · roadway along Z · west +X · water Y = 0"
            : "Metres · +X forward · +Y up · +Z right"}
        </p>
      </div>
    </div>
    {imageQualification(asset.poster) && (
      <p class="mt-3 max-w-reading text-caption text-dim">{imageQualification(asset.poster)}</p>
    )}
    <dl class="mt-6 grid grid-cols-2 gap-5 border-y border-ink py-6 md:grid-cols-4">
      <div>
        <dt class="font-mono text-code text-dim">Triangles</dt>
        <dd class="mt-1 text-2xl font-semibold">
          {number(asset.metrics.triangles)}
        </dd>
      </div>
      <div>
        <dt class="font-mono text-code text-dim">Meshes / materials</dt>
        <dd class="mt-1 text-2xl font-semibold">
          {asset.metrics.meshes} / {asset.metrics.materials}
        </dd>
      </div>
      <div>
        <dt class="font-mono text-code text-dim">Bounds · X × Y × Z</dt>
        <dd class="mt-2 font-mono text-code">
          {bounds(asset.metrics.bounds)} m
        </dd>
      </div>
      <div>
        <dt class="font-mono text-code text-dim">Animation clips</dt>
        <dd class="mt-2 font-mono text-code">
          {asset.metrics.clips.length ? asset.metrics.clips.map((clip) => clip === "ArticulationProbe" ? `${clip} (inspection)` : clip).join(", ") : "None"}
        </dd>
      </div>
    </dl>
    <section class="grid gap-8 pt-12 lg:grid-cols-12" aria-labelledby="review">
      <div class="lg:col-span-4">
        <h2 id="review" class="text-subheading">
          {asset.review.ownerAccepted
            ? "Owner approved"
            : asset.review.status === "changes-requested"
              ? "Accepted child recorded"
              : "Review in progress"}
        </h2>
        <p class="mt-4 max-w-reading text-dim">{asset.review.scope}</p>
        {asset.id === "farmhouse" && (
          <p class="mt-4 max-w-reading">
            The wood-floor child{" "}
            <code class="break-all">{farm.floorRevision.asset.revisionId}</code>{" "}
            was accepted by the owner on 29 September 2026.{" "}
            {asset.revisionId === farm.floorRevision.asset.revisionId
              ? "This delivery includes that accepted revision."
              : `This page’s source, model and downloads remain the sealed ${farm.revision} parent shown above.`}
          </p>
        )}
      </div>
      <figure class="lg:col-span-8">
        <ResponsiveImage image={asset.reviewImage} />
        <figcaption class="mt-3 font-mono text-code text-dim">
          Material-faithful GPU source review views for {asset.revisionId}.
          Structural QA and owner acceptance are separate.{" "}
          {isBridge &&
            "These views come from a source evaluation (exactArtifact: false), not a capture of the exported runtime GLB."}
        </figcaption>
      </figure>
    </section>
    <section class="pt-12" aria-labelledby="source">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 id="source">Read the actual source.</h2>
        <a href={`${asset.sourcePath}?revision=${encodeURIComponent(asset.revisionId)}`} download class="text-link">
          Download .kiln.js ↓
        </a>
      </div>
      <p class="mt-4 max-w-reading text-dim">
        This is the source extracted from the sealed editable archive for the
        displayed revision.
      </p>
      <details class="mt-6 border border-ink">
        <summary class="font-semibold">Open {asset.name} source</summary>
        <CodeBlock code={source} label={`${asset.slug}.kiln.js`} />
      </details>
      <p class="mt-3 break-all font-mono text-code text-dim">
        Source SHA-256: {asset.sourceSha256}
      </p>
      <details class="mt-4 border border-rule">
        <summary class="font-mono text-code">
          Named part paths ({asset.metrics.partPaths.length})
        </summary>
        <ul class="space-y-1 overflow-x-auto px-4 pb-5 font-mono text-code">
          {asset.metrics.partPaths.map((part) => (
            <li class="break-all">{part}</li>
          ))}
        </ul>
      </details>
    </section>
    <section class="pt-16" aria-labelledby="history">
      <h2 id="history">Follow the saved revisions.</h2>
      <p class="mt-4 max-w-reading">
        Originally authored by {asset.provenance.originalModel}.{" "}
        {asset.provenance.refinementModels.length
          ? `Refinements in this delivery: ${asset.provenance.refinementModels.join(", ")}.`
          : "No separate refinement model is recorded for this delivery."}
      </p>
      {isBridge && (
        <p class="mt-4 max-w-reading text-dim">
          The first and review-1 runs requested GPT-6 Astra with ultra effort
          through Codex 0.157.1. Requested effort is not independently
          confirmed. A newer review revision is being independently verified;
          the displayed download remains this recorded revision.
        </p>
      )}
      <ol class="mt-6 border-t border-ink">
        {asset.revisions.map((revision) => (
          <li class="grid gap-4 border-b border-rule py-5 md:grid-cols-2">
            <div>
              <p class="font-semibold">{revision.stage}</p>
              <p class="mt-1">
                {revision.model} · <code>{revision.harness}</code> · harness{" "}
                {revision.harnessVersion ?? "version not recorded"}
              </p>
              <p class="mt-2 text-caption text-dim">
                Requested effort: {revision.requestedEffort ?? "not recorded"}.
                Independently confirmed:{" "}
                {revision.confirmedEffort ?? "not recorded"}.
              </p>
            </div>
            <div>
              <p class="break-all font-mono text-code">{revision.revisionId}</p>
              {"parentRevisionId" in revision && revision.parentRevisionId && (
                <p class="mt-2 break-all font-mono text-code text-dim">
                  Parent: {revision.parentRevisionId}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
      {asset.parentRevision && (
        <p class="mt-4 break-all font-mono text-code text-dim">
          Displayed revision’s parent: {asset.parentRevision}
        </p>
      )}
    </section>
    {isBridge && (
      <section class="pt-16" aria-labelledby="reference">
        <h2 id="reference">The measurements have a reference ledger.</h2>
        <p class="mt-4 max-w-reading">
          Published dimensions, derived values and artistic estimates are
          recorded separately. This is a visual reconstruction, not an
          engineering survey.
        </p>
        <ul class="mt-4 max-w-reading list-disc space-y-2 pl-5">
          {bridge.limits.map((limit) => (
            <li>{limit}</li>
          ))}
        </ul>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {bridge.captures.map((capture) => (
            <figure>
              <ResponsiveImage image={capture} />
              <figcaption class="mt-2 font-mono text-code text-dim">
                {capture.alt}
              </figcaption>
            </figure>
          ))}
        </div>
        <details class="mt-8 border border-ink">
          <summary class="font-semibold">
            Read the complete modeling reference ledger
          </summary>
          <div
            class="prose prose-kiln max-w-reading overflow-x-auto px-5 pb-8"
            set:html={cleanReference
              .replace(/<h1([^>]*)>/g, "<h3$1>")
              .replace(/<\/h1>/g, "</h3>")}
          />
        </details>
        <a class="text-link mt-3" href={bridge.referenceLedger}>
          Download REFERENCE.md ↓
        </a>
      </section>
    )}
    <section class="pt-16" aria-labelledby="downloads">
      <h2 id="downloads">Use the model or revise its source.</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <article class="border-y border-ink py-5">
          <h3 class="text-title">Runtime GLB</h3>
          <p class="mt-3">{bytes(asset.runtimeDownload.bytes)} · glTF 2.0</p>
          <p class="mt-3 break-all font-mono text-code text-dim">
            SHA-256: {asset.runtimeDownload.sha256}
          </p>
          <a class="btn btn-secondary mt-5" href={asset.runtimeDownload.url}>
            Download runtime GLB ↓
          </a>
        </article>
        <article class="border-y border-rule py-5">
          <h3 class="text-title">
            {asset.pack ? "Pack archives" : "Editable archive"}
          </h3>
          {asset.pack ? (
            <>
              <p class="mt-3 max-w-reading">
                Get all 23 assets as runtime GLBs, an editable source package or
                a runnable scene.
              </p>
              <ul class="mt-4 flex flex-wrap gap-x-6">
                {farm.downloads.map((download) => (
                  <li>
                    <a class="text-link capitalize" href={download.url}>
                      {download.profile} ZIP ↓
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/packs/farm/" class="text-link">
                Sizes, SHA-256 and compatibility →
              </a>
            </>
          ) : (
            <>
              <p class="mt-3">
                {bytes(bridge.editableDownload.bytes)} · source, geometry and
                embedded material maps
              </p>
              <p class="mt-3 break-all font-mono text-code text-dim">
                SHA-256: {bridge.editableDownload.sha256}
              </p>
              <a
                class="btn btn-secondary mt-5"
                href={bridge.editableDownload.url}
              >
                Download editable ZIP ↓
              </a>
            </>
          )}
        </article>
      </div>
      <p class="mt-6 max-w-reading text-dim">
        {isBridge ? bridge.licenseScope : farm.licenseScope}
      </p>
      <a
        class="text-link"
        href="https://creativecommons.org/publicdomain/zero/1.0/"
      >
        CC0-1.0 asset content license ↗
      </a>
      {isBridge && (
        <p class="mt-4 max-w-reading text-caption text-dim">
          The Golden Gate Bridge name and likeness are trademarks of the Golden
          Gate Bridge, Highway and Transportation District. The CC0 dedication
          covers copyright in this model only and grants no trademark rights.
        </p>
      )}
    </section>
  </div>
</BaseLayout>

---
import { resolve } from "node:path";
import { readGlbFacts } from "../../../../scripts/engine-note.mjs";
import EngineNote from "../../../components/EngineNote.astro";
import AssetDownloads from "../../../components/AssetDownloads.astro";
import AssetViewer from "../../../components/AssetViewer.astro";
import GalleryTags from "../../../components/GalleryTags.astro";
import PageHeader from "../../../components/PageHeader.astro";
import StatRow from "../../../components/StatRow.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { bounds, bytes, number } from "../../../lib/catalog";
import {
  SEED_TOWN_ID, seedTownAssetHref, seedTownGalleryAssets, seedTownModelUrl,
  seedTownPack, seedTownPackHref, seedTownSceneHref, sizeRange, type SeedTownAsset,
} from "../../../lib/seed-town-gallery";
import { assetDelivery } from "../../../lib/delivery";
import type { DownloadFile } from "../../../lib/download-choices";

export function getStaticPaths() {
  return seedTownGalleryAssets().map((asset) => ({ params: { slug: asset.slug }, props: { asset } }));
}
interface Props { asset: SeedTownAsset }
const { asset } = Astro.props;
const href = seedTownAssetHref(asset.slug);
const downloads = assetDelivery(SEED_TOWN_ID, asset.slug) as ReturnType<typeof assetDelivery> & { runtimeMetadataDownload: DownloadFile };
const metadata = downloads.runtimeMetadataDownload;
if (!metadata) throw new Error(`Seed Town kit needs its runtime metadata download: ${asset.slug}`);
const metadataName = asset.runtimeMetadata.member.split("/").at(-1)!;
const modelName = asset.runtimeModelDownload.member.split("/").at(-1)!;
const modelUrl = seedTownModelUrl(asset);
const modelFacts = await readGlbFacts(resolve("public", modelUrl.split("?")[0]!.slice(1)));
const poster = asset.poster;
const { options, sizes, colours, variants } = asset.parameters;
---
<BaseLayout title={`${asset.name} · Seed Town · Kiln`} description={asset.description}
  breadcrumbs={[
    { label: "Gallery", href: "/gallery/" },
    { label: "Seed Town", href: seedTownPackHref },
    { label: asset.name, href },
  ]} card="gallery">
  <div class="container">
    <div class="grid gap-6 py-8 lg:grid-cols-2">
      <div>
        <PageHeader>{asset.name}</PageHeader>
        <GalleryTags />
        <p class="mt-4 max-w-reading">{asset.description}</p>
      </div>
      <p class="font-mono text-code lg:text-right"><a class="text-link" href={seedTownPackHref}>Seed Town</a></p>
    </div>
    <div class="drawing-sheet">
      <AssetViewer name={asset.name} modelUrl={modelUrl}
        poster={poster?.src} posterAlt={poster?.alt} posterWidth={poster?.width} posterHeight={poster?.height}
        srcsetWebp={poster?.srcsetWebp} srcsetAvif={poster?.srcsetAvif} />
    </div>
    <EngineNote extensions={modelFacts.extensionsUsed} />
    <StatRow values={[
      { label: "Default build", value: `${number(asset.metrics.triangles)} triangles` },
      { label: "Materials", value: asset.metrics.materials },
      { label: "Default dimensions", value: `${bounds(asset.metrics.bounds)} m` },
    ]} />
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn btn-secondary" href={seedTownSceneHref}>Explore the scene</a>
      <a class="btn btn-secondary" href={seedTownPackHref}>View the full pack</a>
    </div>
    <AssetDownloads runtime={downloads.runtimeDownload} editable={downloads.editableDownload} />
    <p class="mt-4 max-w-reading">
      The runtime GLB comes with <a class="text-link" href={metadata.url} download={metadataName}>{metadataName}</a> ({bytes(metadata.bytes)}),
      which maps each option, size and colour below to the nodes, morph targets and materials that carry it.
      Keep it beside {modelName} under the same name.
    </p>
    <section class="pt-12" aria-labelledby="kit-settings">
      <h2 id="kit-settings">What you can set</h2>
      <dl class="mt-6 divide-y divide-rule border-y border-ink">
        {options.map((option) => (
          <div class="grid gap-2 py-4 md:grid-cols-3">
            <dt class="font-mono text-code">{option.name}</dt>
            <dd class="md:col-span-2">
              {"values" in option && option.values ? <span class="font-mono text-code">{option.values.join(", ")}</span> : "On or off"}
              <span class="text-dim"> ({String(option.default)} by default)</span>
              {option.describe && <p class="mt-1 text-dim">{option.describe}</p>}
            </dd>
          </div>
        ))}
        {sizes.map((size) => (
          <div class="grid gap-2 py-4 md:grid-cols-3">
            <dt class="font-mono text-code">{size.name}</dt>
            <dd class="md:col-span-2">{sizeRange(size)}{size.describe && <p class="mt-1 text-dim">{size.describe}</p>}</dd>
          </div>
        ))}
        {colours.map((colour) => (
          <div class="grid gap-2 py-4 md:grid-cols-3">
            <dt class="font-mono text-code">{colour.name}</dt>
            <dd class="md:col-span-2">Colour, <span class="font-mono text-code">{colour.default}</span> by default{colour.describe && <p class="mt-1 text-dim">{colour.describe}</p>}</dd>
          </div>
        ))}
        {variants.length > 0 && (
          <div class="grid gap-2 py-4 md:grid-cols-3">
            <dt class="font-semibold">Material variants</dt>
            <dd class="md:col-span-2"><span class="font-mono text-code">{variants.join(", ")}</span><p class="mt-1 text-dim">Stored in the GLB as KHR_materials_variants.</p></dd>
          </div>
        )}
      </dl>
    </section>
    <section class="pt-12" aria-labelledby="model-details">
      <h2 id="model-details">Model details</h2>
      <dl class="mt-6 divide-y divide-rule border-y border-ink">
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Saved revision</dt><dd class="break-all font-mono text-code md:col-span-2">{asset.revisionId}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Runtime GLB</dt><dd class="break-all font-mono text-code md:col-span-2">{bytes(asset.runtimeModelDownload.bytes)}<br />SHA-256 {asset.runtimeModelDownload.sha256}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Runtime metadata</dt><dd class="break-all font-mono text-code md:col-span-2">{bytes(asset.runtimeMetadata.bytes)}<br />SHA-256 {asset.runtimeMetadata.sha256}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Recorded authoring</dt><dd class="md:col-span-2">{[asset.attribution.model, asset.attribution.harness].filter(Boolean).join(" · ")}</dd></div>
      </dl>
    </section>
    <section class="py-12" aria-labelledby="asset-license">
      <h2 id="asset-license">Licence and attribution</h2>
      <p class="mt-4 max-w-reading">The authored model and Kiln source are <a class="text-link" href={seedTownPack.license.url}>{seedTownPack.license.spdx}</a> to the extent of the owner's rights. The editable archive contains the saved revision and the notices.</p>
    </section>
  </div>
</BaseLayout>

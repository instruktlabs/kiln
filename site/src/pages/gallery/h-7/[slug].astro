---
import EngineNote from "../../../components/EngineNote.astro";
import AssetDownloads from "../../../components/AssetDownloads.astro";
import AssetViewer from "../../../components/AssetViewer.astro";
import GalleryTags from "../../../components/GalleryTags.astro";
import PageHeader from "../../../components/PageHeader.astro";
import StatRow from "../../../components/StatRow.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { bounds, bytes, number } from "../../../lib/catalog";
import { assetDelivery } from "../../../lib/delivery";
import {
  H7_ID, h7AssetHref, h7DemoHref, h7GalleryAssets, h7ModelUrl, h7Pack, h7PackHref, h7Parts, type H7Asset,
} from "../../../lib/h7-gallery";

export function getStaticPaths() {
  return h7GalleryAssets().map((asset) => ({ params: { slug: asset.slug }, props: { asset } }));
}
interface Props { asset: H7Asset }
const { asset } = Astro.props;
const href = h7AssetHref(asset.slug);
const downloads = assetDelivery(H7_ID, asset.slug);
const poster = asset.poster;
const parts = h7Parts(asset.slug).map((part) => ({ part, files: assetDelivery(H7_ID, part.slug) }));
// A saved harness name may carry a session note in brackets; the page names the model and the harness only.
const authoring = [asset.attribution.model, asset.attribution.harness?.replace(/\s*\(.*\)$/, "")].filter(Boolean).join(" · ");
---
<BaseLayout title={`${asset.name} · H-7 · Kiln`} description={asset.description}
  breadcrumbs={[
    { label: "Gallery", href: "/gallery/" },
    { label: "H-7", href: h7PackHref },
    { label: asset.name, href },
  ]} card="gallery">
  <div class="container">
    <div class="grid gap-6 py-8 lg:grid-cols-2">
      <div>
        <PageHeader>{asset.name}</PageHeader>
        <GalleryTags />
        <p class="mt-4 max-w-reading">{asset.description}</p>
      </div>
      <p class="font-mono text-code lg:text-right"><a class="text-link" href={h7PackHref}>H-7</a></p>
    </div>
    <div class="drawing-sheet">
      <AssetViewer name={asset.name} modelUrl={h7ModelUrl(asset)}
        poster={poster?.src} posterAlt={poster?.alt} posterWidth={poster?.width} posterHeight={poster?.height}
        srcsetWebp={poster?.srcsetWebp} srcsetAvif={poster?.srcsetAvif} />
    </div>
    <EngineNote extensions={asset.extensionsUsed} />
    <StatRow values={[
      { label: "Triangles", value: number(asset.metrics.triangles) },
      { label: "Materials", value: asset.metrics.materials },
      { label: "Dimensions", value: `${bounds(asset.metrics.bounds)} m` },
      { label: "Animation", value: asset.clips.length ? asset.clips.join(", ") : "None" },
    ]} />
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn btn-secondary" href={h7DemoHref}>See it in the H-7 demo</a>
      <a class="btn btn-secondary" href={h7PackHref}>View the full pack</a>
    </div>
    <AssetDownloads runtime={downloads.runtimeDownload} editable={downloads.editableDownload} />
    {parts.length > 0 && (
      <section class="pt-12" aria-labelledby="more-models">
        <h2 id="more-models">Also with this asset</h2>
        <dl class="mt-6 divide-y divide-rule border-y border-ink">
          {parts.map(({ part, files }) => (
            <div class="grid gap-2 py-4 md:grid-cols-3">
              <dt class="font-semibold">{part.name}</dt>
              <dd class="md:col-span-2">
                <p>{part.description}</p>
                <p class="mt-2 font-mono text-code">{number(part.metrics.triangles)} triangles · {bounds(part.metrics.bounds)} m</p>
                <p class="mt-2">
                  <a class="text-link" href={files.runtimeDownload.url} download>Model</a> ({bytes(files.runtimeDownload.bytes)}){" · "}
                  <a class="text-link" href={files.editableDownload.url} download>Model with Kiln source</a> ({bytes(files.editableDownload.bytes)})
                </p>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}
    <section class="pt-12" aria-labelledby="model-details">
      <h2 id="model-details">Model details</h2>
      <dl class="mt-6 divide-y divide-rule border-y border-ink">
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Saved revision</dt><dd class="break-all font-mono text-code md:col-span-2">{asset.revisionId}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">GLB</dt><dd class="break-all font-mono text-code md:col-span-2">{bytes(asset.runtimeModelDownload.bytes)}<br />SHA-256 {asset.runtimeModelDownload.sha256}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Recorded authoring</dt><dd class="md:col-span-2">{authoring}</dd></div>
      </dl>
    </section>
    <section class="py-12" aria-labelledby="asset-license">
      <h2 id="asset-license">Licence and attribution</h2>
      <p class="mt-4 max-w-reading">The authored model and Kiln source are <a class="text-link" href={h7Pack.license.url}>{h7Pack.license.spdx}</a> to the extent of the owner's rights. The editable archive contains the saved revision and the notices. The H-7 game and its code are not part of this collection.</p>
    </section>
  </div>
</BaseLayout>

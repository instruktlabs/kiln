---
import AssetViewer from "../../../components/AssetViewer.astro";
import GalleryTags from "../../../components/GalleryTags.astro";
import PageHeader from "../../../components/PageHeader.astro";
import StatRow from "../../../components/StatRow.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { bounds, bytes, number } from "../../../lib/catalog";
import { megabytes } from "../../../lib/text-to-3d";
import { textTo3dAssetHref, textTo3dGalleryAssets, type TextTo3dGalleryAsset } from "../../../lib/text-to-3d-gallery";

export function getStaticPaths() {
  return textTo3dGalleryAssets().map((asset) => ({ params: { slug: asset.slug }, props: { asset } }));
}
interface Props { asset: TextTo3dGalleryAsset }
const { asset } = Astro.props;
const { poster } = asset;
const size = `${megabytes(asset.runtimeDownload.bytes)} MB`;
---
<BaseLayout title={`${asset.name} · Kiln`} description={asset.description}
  breadcrumbs={[
    { label: "Gallery", href: "/gallery/" },
    { label: asset.name, href: textTo3dAssetHref(asset.slug) },
  ]} card="gallery">
  <div class="container">
    <div class="grid gap-6 py-8 lg:grid-cols-2">
      <div>
        <PageHeader>{asset.name}</PageHeader>
        <GalleryTags />
        <p class="mt-4 max-w-reading">{asset.description}</p>
      </div>
      <p class="font-mono text-code lg:text-right"><a class="text-link" href={asset.madeHref}>See how it was made <span aria-hidden="true">→</span></a></p>
    </div>
    <div class="drawing-sheet">
      <AssetViewer name={asset.name} modelUrl={asset.runtimeDownload.url}
        poster={poster.src} posterAlt={poster.alt} posterWidth={poster.width} posterHeight={poster.height}
        srcsetWebp={poster.srcsetWebp} srcsetAvif={poster.srcsetAvif}
        openLabel={`Open 3D view, ${size}`} />
    </div>
    <StatRow values={[
      { label: "Triangles", value: number(asset.metrics.triangles) },
      { label: "Materials", value: asset.metrics.materials },
      { label: "Dimensions", value: `${bounds(asset.metrics.bounds)} m` },
      { label: "Animation", value: asset.metrics.clips.join(", ") },
    ]} />
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn" href={asset.runtimeDownload.url} download>Download GLB, {size} <span aria-hidden="true">↓</span></a>
      <a class="btn btn-secondary" href={asset.source.sourceHref} download>Download source, {number(asset.source.sourceLines)} lines <span aria-hidden="true">↓</span></a>
    </div>
    <section class="pt-12" aria-labelledby="model-details">
      <h2 id="model-details">Model details</h2>
      <dl class="mt-6 divide-y divide-rule border-y border-ink">
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">GLB</dt><dd class="break-all font-mono text-code md:col-span-2">{bytes(asset.runtimeDownload.bytes)}<br />SHA-256 {asset.runtimeDownload.sha256}</dd></div>
        <div class="grid gap-2 py-4 md:grid-cols-3"><dt class="font-semibold">Source</dt><dd class="md:col-span-2">One JavaScript program, written by a coding agent with Kiln. The GLB is that program's output with its rigid parts joined into one skinned mesh.</dd></div>
      </dl>
    </section>
    <section class="py-12" aria-labelledby="asset-license">
      <h2 id="asset-license">Licence</h2>
      <p class="mt-4 max-w-reading">The model and its Kiln source are <a class="text-link" href="https://creativecommons.org/publicdomain/zero/1.0/">CC0-1.0</a> to the extent of Instrukt Labs' rights: use both for anything.</p>
    </section>
  </div>
</BaseLayout>

---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import {
  INSTALL_COMMAND,
  PACKAGE_TARBALL,
  WORKSPACE_COMMAND,
  RELEASE_TAG,
  VERSION,
  VERSION_SHORT,
} from "../../lib/config";
import { installGuideNote } from "../../lib/install-note";
export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"docs">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  current={entry.id}
  headings={headings}
  source={entry.data.source}
>
  <h1 id={headings.find((heading) => heading.depth === 1)?.slug}>
    {entry.data.title}
  </h1>
  {entry.id === "install" && (
    <aside
      aria-label={`${VERSION_SHORT} release status`}
      class="not-prose my-8 space-y-4 border-l-2 border-ember bg-stage p-5"
    >
      <h2 class="text-xl font-semibold">
        Install the {VERSION_SHORT} release package
      </h2>
      <p>
        The <code>{RELEASE_TAG}</code> release is pending. These commands
        become usable when it is published with its package tarball,{" "}
        <code>{PACKAGE_TARBALL}</code>, and <code>SHA256SUMS.txt</code>. Kiln
        is not published to the npm registry.
      </p>
      <CodeBlock
        code={`${INSTALL_COMMAND}\n${WORKSPACE_COMMAND}`}
        lang="sh"
        label={`${VERSION_SHORT} package install`}
      />
      <p>
        Then run <code>cd ../my-assets</code> and follow <code>START.md</code>{" "}
        for your harness.
      </p>
      <p class="text-sm text-dim">{installGuideNote(entry.body ?? "", VERSION)}</p>
    </aside>
  )}
  <Content />
</DocsLayout>

---
import DocsMobileNav from "../../components/docs/DocsMobileNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import Callout from "../../components/Callout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import {
  INSTALL_COMMAND,
  PACKAGE_TARBALL,
  WORKSPACE_COMMAND,
  RELEASE_TAG,
  VERSION,
  VERSION_SHORT,
} from "../../lib/config";
import { installGuideNote } from "../../lib/install-note";
export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"docs">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  current={entry.id}
  headings={headings}
  source={entry.data.source}
  verbatim
>
  <PageHeader id={headings.find((heading) => heading.depth === 1)?.slug}>
    {entry.data.title}
    <DocsMobileNav slot="navigation" current={entry.id} headings={headings} />
  </PageHeader>
  {entry.id === "install" && (
    <Callout label={`${VERSION_SHORT} candidate status`} boundary>
      <h2 class="text-xl font-semibold">
        Install the local {VERSION_SHORT} package
      </h2>
      <p>
        The <code>{RELEASE_TAG}</code> candidate is under local review. Build
        <code>{PACKAGE_TARBALL}</code> from the reviewed source as described below,
        then install that local tarball. Kiln
        is not published to the npm registry; publication is planned for v1.0 after deployed dogfooding.
      </p>
      <CodeBlock
        code={`mkdir kiln-install\ncd kiln-install\nnpm init -y\n${INSTALL_COMMAND}`}
        lang="sh"
        label={`${VERSION_SHORT} package install`}
      />
      <p>
        Create the workspace with <code>{WORKSPACE_COMMAND}</code>, then run
        <code>cd ../my-assets</code> and follow <code>START.md</code> for your harness.
      </p>
      <p class="text-sm text-dim">{installGuideNote(entry.body ?? "", VERSION)}</p>
    </Callout>
  )}
  <Content />
</DocsLayout>

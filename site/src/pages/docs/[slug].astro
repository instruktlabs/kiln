---
import DocsMobileNav from "../../components/docs/DocsMobileNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { VERSION, RELEASE_URL } from "../../lib/config";
export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"docs">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  current={entry.id}
  headings={headings}
  source={entry.data.source}
  verbatim
>
  <PageHeader id={headings.find((heading) => heading.depth === 1)?.slug}>
    {entry.data.title}
    <DocsMobileNav slot="navigation" current={entry.id} headings={headings} />
  </PageHeader>
  <p class="text-caption text-dim">
    Latest published package: <a href={RELEASE_URL}>Kiln {VERSION}</a>.
    Earlier versions below identify feature requirements or historical results.
  </p>
  <Content />
</DocsLayout>

---
import DocsMobileNav from "../../components/docs/DocsMobileNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { DOC_GROUPS } from "../../lib/docs-navigation";
const available = new Set((await getCollection("docs")).map((page) => page.id));
---

<DocsLayout
  title="Docs"
  description="Install Kiln, connect your coding agent, and learn the source, rendering, revision and export tools."
>
  <PageHeader>Docs<DocsMobileNav slot="navigation" /></PageHeader>
  <p>
    Start with an asset workspace, then use the same source through rendering,
    revision and export. These pages are built from the engine repository’s
    documentation.
  </p>
  {DOC_GROUPS.map((group) => (
    <section aria-labelledby={`docs-${group.title.toLowerCase()}`}>
      <h2 id={`docs-${group.title.toLowerCase()}`}>{group.title}</h2>
      <p>{group.description}</p>
      <dl class="not-prose divide-y divide-rule border-y border-rule">
        {group.pages
          .filter((page) => available.has(page.slug))
          .map((page) => (
            <div class="py-5">
              <dt class="font-semibold">
                <a
                  class="inline-flex min-h-11 items-center"
                  href={`/docs/${page.slug}/`}
                >
                  {page.label}{" "}
                  <span aria-hidden="true" class="ml-2">
                    →
                  </span>
                </a>
              </dt>
              <dd class="m-0 text-sm leading-relaxed">{page.description}</dd>
            </div>
          ))}
      </dl>
    </section>
  ))}
</DocsLayout>

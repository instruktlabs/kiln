---
import PageHeader from "../components/PageHeader.astro";
import StatRow from "../components/StatRow.astro";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroDrawing from "../components/HeroDrawing.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import ScenePoster from "../components/ScenePoster.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { farm, vehicles, number, bounds } from "../lib/catalog";
import { harnessName, modelName } from "../lib/attribution";
import { hero, HERO_IMAGE_SIZES } from "../lib/hero";
import {
  HARNESSES,
  INSTALL_COMMAND,
  PACKAGE_TARBALL,
  WORKSPACE_COMMAND,
  PACKS_ENABLED,
  REPO,
  VERSION,
  VERSION_SHORT,
} from "../lib/config";
import exchange from "../data/home-exchange.json";
import foundryFloor from "../data/foundry-floor.json";
import foundryFloorPack from "../data/packs/foundry-floor.json";
import { sceneRuntimes } from "virtual:kiln-scenes";
import { farmScene, foundryFloorScene, goldenGateScene } from "../data/scenes";
import { PUBLIC_EXAMPLES } from "../../scripts/collection.mjs";
const house = farm.assets[0]!;
const docs = new Set((await getCollection("docs")).map((doc) => doc.id));
const docHref = (slug: string) =>
  docs.has(slug) ? `/docs/${slug}/` : `${REPO}/blob/main/docs/${slug}.md`;
const source = PACKS_ENABLED
  ? await readFile(resolve("public", house.sourcePath.slice(1)), "utf8")
  : "";
const floor = farm.floorRevision;
const ship = [
  [
    "MCP server",
    "17 tools on the packaged local host: discover, render, inspect, revise and retain exact work.",
    "tools",
  ],
  [
    "CLI",
    "Render source, export a GLB or manage saved revisions from your terminal.",
    "install",
  ],
  [
    "TypeScript library",
    "Use the engine and its host ports in your own application.",
    "architecture",
  ],
  [
    "Agent skills",
    "Workspace setup, authoring, refinement, QA, scene composition and batch dispatch.",
    "clean-room",
  ],
  [
    "GPU render service",
    "Optional material-faithful views. CPU fallback checks geometry and reports its fidelity.",
    "rendering",
  ],
  [
    "Local Workshop",
    "Library, optional Projects and Live Review share saved assets and observation records.",
    "projects-and-live-review",
  ],
  [
    "Material library",
    "Pin material records and texture maps; keep recipes and provenance with the asset.",
    "material-library",
  ],
];
const [discover, render, edit, save] = exchange.events;
const toolExample = `kiln_discover(${JSON.stringify(discover!.arguments)})
// → ${JSON.stringify({ id: discover!.result.id })}
// … further catalog fields omitted

kiln_render(${JSON.stringify(render!.arguments)})
// → ${JSON.stringify({ ok: render!.result.ok, programRef: render!.result.programRef, tris: render!.result.tris })}
// … capture arguments, views and further checks omitted

kiln_edit(${JSON.stringify(edit!.arguments, null, 2)})
// → ${JSON.stringify({ ok: edit!.result.ok, programRef: edit!.result.programRef, parentRef: edit!.result.parentRef })}
// … six edits, capture arguments and preservation evidence omitted

kiln_save(${JSON.stringify(save!.arguments, null, 2)})
// → asset.revisionId: ${save!.result.asset!.revisionId}
// … project arguments, file hashes and further result fields omitted`;
const floorIncluded = house.revisionId === floor.asset.revisionId;
const CARD_SIZES = "(max-width: 767px) 100vw, 33vw";
---

<BaseLayout
  title="Kiln — build and revise 3D assets with your coding agent"
  description="Your coding agent writes JavaScript. Kiln renders views, checks geometry and saves editable 3D assets as GLBs with their source. Runs locally; MIT licensed."
  preloadImage={
    PACKS_ENABLED
      ? {
          src: hero.poster.src,
          srcset: hero.poster.srcsetAvif,
          sizes: HERO_IMAGE_SIZES,
        }
      : undefined
  }
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "Kiln",
    description:
      "Local tools for coding agents to build and revise 3D assets as JavaScript.",
    codeRepository: REPO,
    programmingLanguage: "TypeScript",
    license: `${REPO}/blob/main/LICENSE`,
    version: VERSION,
  }}
>
  <script slot="head" is:inline define:vars={{ known: PUBLIC_EXAMPLES }}>
    function redirectLegacy() {
      if (!location.hash.startsWith("#/")) return;
      const slug = location.hash.slice(2).replace(/\/$/, "");
      location.replace(
        known.includes(slug)
          ? "/gallery/archive/" + slug + "/"
          : "/gallery/archive/",
      );
    }
    window.addEventListener("hashchange", redirectLegacy);
    redirectLegacy();
  </script>
  <div class="container pt-6 md:pt-8">
    <div class="drawing-sheet">
      <div class="grid gap-2 px-5 pt-6 md:px-8 md:pt-8 xl:grid-cols-[7fr_5fr] xl:items-center xl:gap-12 xl:pt-4">
        <div class="py-4 md:py-6 xl:py-12">
          <PageHeader class="max-w-lead">
            Build and revise 3D assets with your coding agent.
          </PageHeader>
          <p class="lead mt-6">
            Your agent writes the asset as JavaScript; Kiln runs it, returns
            rendered views and structural checks, and exports a GLB with its
            source.
          </p>
          <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
            <a href="/docs/install/" class="btn">
              Get Kiln {VERSION_SHORT} <span aria-hidden="true">→</span>
            </a>
            <a href="/gallery/" class="btn btn-secondary">
              Browse the gallery
            </a>
          </div>
          <p class="mt-6 max-w-lead font-mono text-code text-dim">
            MIT · runs on your machine · MCP, CLI, TypeScript library and agent
            skills · {VERSION_SHORT} preview
          </p>
        </div>
        {PACKS_ENABLED && <HeroDrawing />}
      </div>
    </div>
  </div>
  {PACKS_ENABLED && (
    <>
      <section class="container pt-16 md:pt-24" aria-labelledby="loop-heading">
        <div class="grid gap-6 lg:grid-cols-2 lg:gap-12">
          <h2 id="loop-heading">
            The source is something your agent can change.
          </h2>
          <p class="max-w-reading text-dim">
            A roof pitch, a named part, a material pin: the shape has an
            editable definition. Kiln returns views and geometry checks so your
            agent can inspect what the program actually built. Here one
            request changes the farmhouse floor and leaves the rest of the
            house as it was.
          </p>
        </div>
        <figure class="mt-8 border border-ink bg-sheet p-5" aria-label="A recorded farmhouse revision, from request to delivery">
          <figcaption class="mb-5 font-semibold">One farmhouse revision, from request to files</figcaption>
          <ol class="loop-artifacts grid gap-6 lg:grid-cols-6">
            <li><h3 class="text-title">1. Request</h3><p class="mt-2 text-caption">A wood ground floor in place of the masonry-looking floor.</p><span class="loop-connector" aria-hidden="true"></span></li>
            <li><h3 class="text-title">2. Source</h3><pre class="mt-2 whitespace-pre-wrap break-words text-code"><code>{source.split('\n').filter((line) => /createPart\('InteriorFloor'/.test(line)).slice(0, 1).join('\n')}</code></pre><span class="loop-connector" aria-hidden="true"></span></li>
            <li class="lg:col-span-2">
              <h3 class="text-title">3. Inspect</h3>
              <div class="mt-2 grid grid-cols-2 gap-3">
                <figure>
                  <ResponsiveImage image={floor.before} sizes="(min-width:1024px) 14vw, 50vw" />
                  <figcaption class="mt-1 font-mono text-code">Before · masonry-looking</figcaption>
                </figure>
                <figure>
                  <ResponsiveImage image={floor.after} sizes="(min-width:1024px) 14vw, 50vw" />
                  <figcaption class="mt-1 font-mono text-code">After · wood</figcaption>
                </figure>
              </div>
              <p class="mt-2 text-caption">Bounds unchanged. 132 exterior probes unchanged.</p>
              <span class="loop-connector" aria-hidden="true"></span>
            </li>
            <li><h3 class="text-title">4. Retain</h3><p class="mt-2 font-mono text-code break-all">{floor.asset.revisionId}</p><p class="mt-2 text-caption">Saved as a new revision; the parent stays intact.</p><span class="loop-connector" aria-hidden="true"></span></li>
            <li><h3 class="text-title">5. Deliver</h3><a class="text-link" href={house.modelPath}>Farmhouse GLB</a><br /><a class="text-link" href={house.sourcePath}>Editable source</a><p class="mt-2 text-caption">The same saved revision.</p></li>
          </ol>
        </figure>
        <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5">
            <p class="max-w-reading">
              Gemini 3.8 Flash via Antigravity CLI edited the source written by
              Claude Opus 5.5. Kiln rendered the room before and after: 132
              exterior probes identical, bounds unchanged. Fourteen meshes, all
              transforms and all materials stayed unchanged; the stone shell
              was re-tessellated around the new floor.
            </p>
            <p class="mt-4 max-w-reading">
              The child revision keeps its parent and model attribution.{" "}
              {floorIncluded
                ? "The current downloads include the wood floor."
                : `The sealed ${farm.revision} downloads still contain the earlier floor.`}
            </p>
            <a class="text-link mt-3" href="/gallery/farmhouse/">
              Inspect the farmhouse and its history <span aria-hidden="true">→</span>
            </a>
          </div>
          <dl class="min-w-0 self-start border-y border-rule py-4 font-mono text-code lg:col-span-7">
            <div class="grid gap-1 py-2 sm:grid-cols-4">
              <dt class="text-dim">Parent</dt>
              <dd class="break-all sm:col-span-3">{floor.parentRevision}</dd>
            </div>
            <div class="grid gap-1 py-2 sm:grid-cols-4">
              <dt class="text-dim">Child</dt>
              <dd class="break-all sm:col-span-3">
                {floor.asset.revisionId}
              </dd>
            </div>
            <div class="grid gap-1 py-2 sm:grid-cols-4">
              <dt class="text-dim">Attribution</dt>
              <dd class="sm:col-span-3">{modelName("gemini-3.8-flash-high")} · {harnessName("agy")}</dd>
            </div>
          </dl>
        </div>
        <div class="mt-8 grid items-start gap-6 lg:grid-cols-2">
          <div class="min-w-0">
            <CodeBlock code={source} label="Farmhouse · source.kiln.js" />
            <p class="mt-3 break-all font-mono text-code text-dim">
              Source from the sealed {farm.revision} farmhouse,{" "}
              {house.revisionId}.
            </p>
          </div>
          <figure>
            <ResponsiveImage image={house.reviewImage} />
            <figcaption class="mt-3 font-mono text-code text-dim">
              The saved GPU review sheet: front, right, back, left, top and
              three-quarter views.
            </figcaption>
          </figure>
        </div>
        <StatRow values={[{ label: "Triangles", value: number(house.metrics.triangles) }, { label: "Meshes", value: house.metrics.meshes }, { label: "Materials", value: house.metrics.materials }]} />
        <dl class="grid gap-6 border-b border-rule py-6 sm:grid-cols-2">
          <div>
            <dt class="font-mono text-code text-dim">Bounds · metres</dt>
            <dd class="mt-1 font-mono text-code">
              {bounds(house.metrics.bounds)}
            </dd>
          </div>
          <div>
            <dt class="font-mono text-code text-dim">Named parts</dt>
            <dd class="mt-1 break-words font-mono text-code">
              Mesh_RoofShingles
              <br />
              Mesh_PorchTimber
            </dd>
          </div>
        </dl>
        <div class="mt-10 grid gap-6 border-t border-ink pt-6 md:grid-cols-2">
          <div>
            <h3>Checks read the file, not the picture.</h3>
            <p class="mt-4 max-w-reading text-dim">
              Every render comes back with a QA report on the exported GLB:
              whether it is valid glTF, whether the parts the request named are
              there, and what it will cost to draw. Checks read geometry and
              export data, never pixels.
            </p>
          </div>
          <dl class="border-y border-rule font-mono text-code">
            {[
              ["exportIntegrity", "pass · 0 glTF errors / warnings"],
              ["requirementReadiness", "pass"],
              ["visualQuality", "pass"],
              ["triangles", "4,080"],
              ["namedParts", "16"],
            ].map(([key, value]) => (
              <div class="flex flex-wrap justify-between gap-2 border-b border-rule px-3 py-2 last:border-b-0">
                <dt>{key}</dt>
                <dd class="text-wire">
                  {value}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    </>
  )}
  <section class="container section-space" aria-labelledby="agent-heading">
    <div class="grid gap-8 border-t border-ink pt-8 lg:grid-cols-2 lg:gap-12">
      <div class="min-w-0">
        <h2 id="agent-heading">Your coding agent drives the same tools.</h2>
        <p class="mt-6 max-w-reading">
          Kiln has no model of its own. Your agent supplies the model; no
          separate model key is needed.
        </p>
        <p class="mt-4 max-w-reading">
          Create a workspace with <code>kiln-init</code>. It writes the MCP
          configuration and skills for your harness. Follow the generated{" "}
          <code>START.md</code> to connect.
        </p>
        <ul
          class="mt-5 flex flex-wrap gap-2"
          aria-label="Supported harness flags"
        >
          {HARNESSES.map((h) => (
            <li class="border border-rule bg-sheet px-3 py-2 font-mono text-code">
              --harness {h}
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <CodeBlock
            code={WORKSPACE_COMMAND}
            lang="bash"
            label="Create an asset workspace"
          />
        </div>
      </div>
      <div class="min-w-0">
        <CodeBlock
          code={toolExample}
          label={`Recorded farmhouse tool exchange · Kiln ${exchange.engineVersion} · abridged`}
        />
        <p class="mt-3 text-caption text-dim">
          {exchange.description.replace("through the claude harness", "through Claude Code")} The run used Kiln {exchange.engineVersion}, so
          this is a record of that version, not a {VERSION_SHORT} transcript.
          Ellipses mark omitted payloads; local paths and host identifiers are
          removed.{" "}
          <a href="/docs/tools/" class="text-ink underline">
            Read the complete tool contracts.
          </a>
        </p>
      </div>
    </div>
  </section>
  <section class="container" aria-labelledby="ships-heading">
    <div class="grid items-end gap-6 md:grid-cols-2">
      <h2 id="ships-heading">The local toolchain ships together.</h2>
      <p class="max-w-reading text-dim">
        The {VERSION_SHORT} package includes the tools, authoring
        guidance and local review interface. Add the GPU service when material
        appearance matters.
      </p>
    </div>
    <dl class="mt-8 border-t border-ink">
      {ship.map(([name, description, slug]) => (
        <div class="grid gap-2 border-b border-rule py-5 md:grid-cols-12 md:gap-6">
          <dt class="font-semibold md:col-span-3">
            <a class="text-link" href={docHref(slug!)}>
              {name}
            </a>
          </dt>
          <dd class="max-w-reading self-center md:col-span-9">{description}</dd>
        </div>
      ))}
    </dl>
  </section>
  <section class="container section-space" aria-labelledby="made-heading">
    <h2 id="made-heading" class="max-w-reading">
      The saved work is yours to inspect.
    </h2>
    <p class="mt-5 max-w-reading text-dim">
      Browse the models, read the source and follow their revisions. Commons
      assets can be used without installing Kiln.
    </p>
    {PACKS_ENABLED ? (
      <>
      <div class="mt-8 grid gap-10 md:grid-cols-3 md:gap-8">
        <article>
          <a href="/packs/farm/" class="block no-underline text-ink" aria-label="Shapes &amp; Seasons Farm">
            <ScenePoster images={farmScene.posterImages} sizes={CARD_SIZES} decorative />
            <h3 class="mt-5 text-ink">Shapes &amp; Seasons Farm</h3>
          </a>
          <p class="mt-2 text-dim">
            23 assets, their editable source and a runnable scene.
          </p>
          <div class="mt-2 flex flex-wrap gap-x-6">
            <a class="text-link" href="/packs/farm/">Browse the Farm pack</a>
            <a class="text-link" href="/scenes/farm/">Open the scene</a>
          </div>
        </article>
        <article>
          <a href={goldenGateScene.href} class="block no-underline text-ink" aria-label="Golden Gate Bridge scene">
            <ScenePoster images={goldenGateScene.posterImages} sizes={CARD_SIZES} decorative />
            <h3 class="mt-5 text-ink">Golden Gate Bridge</h3>
          </a>
          <p class="mt-2 text-dim">
            A driving and traffic scene on a bridge authored from
            published dimensions, with procedural source and GPU captures.
          </p>
          <div class="mt-2 flex flex-wrap gap-x-6">
            <a class="text-link" href={goldenGateScene.href}>Open the scene</a>
            <a class="text-link" href="/gallery/golden-gate-bridge/">The bridge asset</a>
          </div>
        </article>
        <article>
          <a href={foundryFloor.sceneRoute} class="block no-underline text-ink" aria-label={`${foundryFloor.name} scene`}>
            <ScenePoster
              images={foundryFloorScene.posterImages}
              sizes={CARD_SIZES}
              decorative
            />
            <h3 class="mt-5 text-ink">{foundryFloor.name}</h3>
          </a>
          <p class="mt-2 text-dim">
            In production: {foundryFloorPack.assetCount} models for a fictional
            2 nm-class chip fab, and a scene of its campus and fab floor where
            the factory runs.
          </p>
          <div class="mt-2 flex flex-wrap gap-x-6">
            <a class="text-link" href={foundryFloor.sceneRoute}>
              {sceneRuntimes["foundry-floor"] ? "The scene preview" : "The scene status"}
            </a>
            <a class="text-link" href={foundryFloor.packRoute}>The pack in production</a>
          </div>
        </article>
      </div>
      <article class="mt-10 grid items-center gap-6 border-t border-rule pt-8 md:grid-cols-3 md:gap-8">
        <ul class="grid grid-cols-3 gap-2 md:col-span-2 md:grid-cols-6">
          {vehicles.assets.map((asset) => (
            <li class="bg-stage">
              <a href={`/gallery/${asset.slug}/`} class="block">
                <ResponsiveImage
                  image={{ ...asset.poster, alt: asset.name }}
                  sizes="(max-width: 767px) 33vw, 11vw"
                  class="aspect-square w-full object-contain"
                />
              </a>
            </li>
          ))}
        </ul>
        <div>
          <h3 class="text-title">
            <a href="/packs/vehicles/" class="text-ink no-underline">{vehicles.name}</a>
          </h3>
          <p class="mt-2 text-dim">
            Six road vehicles with no brand or livery, each with three detail
            tiers, separate wheels and its source. They are the traffic of the
            Golden Gate scene.
          </p>
          <a class="text-link mt-2" href="/packs/vehicles/">
            Browse the vehicles pack <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
      </>
    ) : (
      <p class="mt-8 border-y border-rule py-6">
        The Commons catalog is being prepared for publication. The archive
        remains available below.
      </p>
    )}
    <div class="mt-10 grid gap-8 border-y border-rule py-6 md:grid-cols-2">
      {!PACKS_ENABLED && (
        <div>
          <h3 class="text-title">{foundryFloor.name}</h3>
          <p class="mt-2 max-w-reading text-dim">
            In production: a fictional 2 nm-class chip fab pack with process
            tools, wafer transport and a scene where the factory runs.
          </p>
          <div class="flex flex-wrap gap-x-6">
            <a href={foundryFloor.packRoute} class="text-link">Production note</a>
            <a href={foundryFloor.sceneRoute} class="text-link">
              {sceneRuntimes["foundry-floor"] ? "The scene preview" : "The scene status"}
            </a>
          </div>
        </div>
      )}
      <div>
        <h3 class="text-title">Earlier examples</h3>
        <p class="mt-2 max-w-reading text-dim">
          Earlier examples from earlier Kiln versions.
        </p>
        <a class="text-link" href="/gallery/archive/">
          Open the archive <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
  <section class="container" aria-labelledby="start-heading">
    <div class="grid gap-8 border-t border-ink pt-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <h2 id="start-heading" class="text-subheading">Try Kiln 0.9 locally.</h2>
        <p class="mt-5 max-w-reading">
          Use Node.js 20.15+ on the 20.x line, or 22.2 and later. Kiln is not
          published to the npm registry. Build the package tarball locally
          from the reviewed source, then install <code>{PACKAGE_TARBALL}</code>
          from that build. The installation guide includes the build commands.
        </p>
        <p class="mt-4 max-w-reading text-dim">
          The v{VERSION} preview is available for dogfooding. Package publication
          is planned for v1.0 after deployed dogfooding and feedback. Give npm
          your locally built tarball’s real path.
        </p>
        <a href="/docs/install/" class="text-link mt-3">
          Read the installation guide <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="min-w-0 space-y-4 lg:col-span-8">
        <CodeBlock
          code={`mkdir kiln-install\ncd kiln-install\nnpm init -y\n${INSTALL_COMMAND}`}
          lang="bash"
          label={`Install Kiln ${VERSION_SHORT}`}
        />
        <CodeBlock
          code={`${WORKSPACE_COMMAND}\ncd ../my-assets\n# Follow START.md for your harness`}
          lang="bash"
          label="Connect your coding agent"
        />
      </div>
    </div>
  </section>
</BaseLayout>

---
import PageHeader from "../components/PageHeader.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HolodeckShowcase from "../components/HolodeckShowcase.astro";
import AssetCard from "../components/AssetCard.astro";
import { featuredWorlds, featuredAssetHrefs, worldCover } from "../lib/site-curation";
import { galleryCards } from "../lib/gallery";
import { holodeckPackHref, holodeckWorldUrl } from "../lib/holodeck";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { Image } from "astro:assets";
import sheepdogGameShot from "../assets/live-games/sheepdog-sim.webp";
import objektGameShot from "../assets/live-games/objekt62.webp";
import skiVillageShot from "../assets/live-games/ski-sim-village.webp";
import skiCharacterShot from "../assets/live-games/ski-sim-skier.webp";
import CodeBlock from "../components/CodeBlock.astro";
import {
  HARNESSES,
  INSTALL_COMMAND,
  WORKSPACE_COMMAND,
  PACKS_ENABLED,
  REPO,
  DISCORD,
  VERSION,
  VERSION_SHORT,
} from "../lib/config";
import workflow from "../data/asset-to-scene.json";
import AssetToScene from "../components/AssetToScene.astro";
import { PUBLIC_EXAMPLES } from "../../scripts/collection.mjs";
const docs = new Set((await getCollection("docs")).map((doc) => doc.id));
const docHref = (slug: string) =>
  docs.has(slug) ? `/docs/${slug}/` : `${REPO}/blob/main/docs/${slug}.md`;
const ship = [
  [
    "MCP server",
    "17 tools on the packaged local host: discover, render, inspect, revise and retain exact work.",
    "tools",
  ],
  [
    "CLI",
    "Render source, export a GLB or manage saved revisions from your terminal.",
    "install",
  ],
  [
    "TypeScript library",
    "Use the engine and its host ports in your own application.",
    "architecture",
  ],
  [
    "Agent skills",
    "Workspace setup, authoring, refinement, QA, scene composition and batch dispatch.",
    "clean-room",
  ],
  [
    "GPU render service",
    "Optional material-faithful views. CPU fallback checks geometry and reports its fidelity.",
    "rendering",
  ],
  [
    "Local Workshop",
    "Library, optional Projects and Live Review share saved assets and observation records.",
    "projects-and-live-review",
  ],
  [
    "Material library",
    "Pin material records and texture maps; keep recipes and provenance with the asset.",
    "material-library",
  ],
];
const leadWorld = featuredWorlds[0]!;
const leadCover = worldCover(leadWorld.id)!;
const featuredAssets = featuredAssetHrefs.map((href) => {
  const asset = galleryCards.find((card) => card.href === href);
  if (PACKS_ENABLED && !asset) throw new Error(`Missing featured asset ${href}`);
  return asset;
}).filter((asset) => asset !== undefined);
const LEAD_SIZES = "(max-width: 1279px) 100vw, 50vw";
const CARD_SIZES = "(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc(50vw - 48px), (max-width: 1439px) calc(50vw - 88px), 632px";
---

<BaseLayout
  title="Kiln | build and revise 3D assets with your coding agent"
  description="Your coding agent writes JavaScript. Kiln renders views, checks geometry and saves editable 3D assets as GLBs with their source. Runs locally; MIT licensed."
  preloadImage={
    PACKS_ENABLED
      ? {
          src: leadCover.src,
          srcset: leadCover.srcsetAvif,
          sizes: LEAD_SIZES,
        }
      : undefined
  }
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "Kiln",
    description:
      "Local tools for coding agents to build and revise 3D assets as JavaScript.",
    codeRepository: REPO,
    programmingLanguage: "TypeScript",
    license: `${REPO}/blob/main/LICENSE`,
    version: VERSION,
  }}
>
  <script slot="head" is:inline define:vars={{ known: PUBLIC_EXAMPLES }}>
    function redirectLegacy() {
      if (!location.hash.startsWith("#/")) return;
      const slug = location.hash.slice(2).replace(/\/$/, "");
      location.replace(
        known.includes(slug)
          ? "/gallery/archive/" + slug + "/"
          : "/gallery/archive/",
      );
    }
    window.addEventListener("hashchange", redirectLegacy);
    redirectLegacy();
  </script>
  <div class="container pt-6 md:pt-8">
    <div class="drawing-sheet">
      <div class="grid gap-2 px-5 pt-6 md:px-8 md:pt-8 xl:grid-cols-2 xl:items-center xl:gap-12 xl:pt-4">
        <div class="py-4 md:py-6 xl:py-12">
          <p class="mb-4 inline-block border border-rule px-2 py-1 font-mono text-caption text-dim">text-to-3d</p>
          <PageHeader class="max-w-lead">
            Build and revise 3D assets with your coding agent.
          </PageHeader>
          <p class="lead mt-6">
            Your agent writes the asset as JavaScript; Kiln runs it, returns
            rendered views and structural checks, and exports a GLB with its
            source.
          </p>
          <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
            <a href="/docs/install/" class="btn">
              Get Kiln {VERSION_SHORT} <span aria-hidden="true">→</span>
            </a>
            <a href="/gallery/" class="btn btn-secondary">
              Browse the gallery
            </a>
          </div>
          <p class="mt-4 max-w-lead">
            <a class="text-link" href="https://holodeck.kilnstudio.tools/">Play worlds on the Holodeck shelf <span aria-hidden="true">↗</span></a>
          </p>
          <p class="mt-6 max-w-lead font-mono text-code text-dim">
            MIT · runs on your machine · MCP, CLI, TypeScript library and agent
            skills · {VERSION_SHORT}
          </p>
          <p class="mt-4 max-w-lead text-dim">Prefer hosted access? <a href={DISCORD}>Request an invitation on Discord.</a></p>
        </div>
        {PACKS_ENABLED && <figure class="min-w-0 pb-8 xl:py-8">
          <a href={holodeckWorldUrl(leadWorld.id)} class="block text-ink no-underline">
            <ResponsiveImage image={leadCover} sizes={LEAD_SIZES} eager class="aspect-video w-full object-cover" />
          </a>
          <figcaption class="mt-4">
            <a class="text-title font-semibold text-ink no-underline" href={holodeckWorldUrl(leadWorld.id)}>Walk {leadWorld.name} <span aria-hidden="true">↗</span></a>
            <p class="mt-2 text-dim">Marble arcades, mirror pools and floating sculpture above a sea of cloud. Built in Holodeck with Kiln assets.</p>
            <a href={holodeckPackHref(leadWorld)} class="text-link mt-3">Inspect its {leadWorld.assetCount} editable assets</a>
          </figcaption>
        </figure>}
      </div>
    </div>
  </div>
  {PACKS_ENABLED && <div class="container pb-8"><HolodeckShowcase id="worlds-heading" heading="From coast to mountains." skipLead /></div>}
  <section id="live-games" class="container section-space" aria-labelledby="live-games-heading">
    <div class="grid gap-6 border-t border-ink pt-8 lg:grid-cols-2 lg:gap-12">
      <div>
        <p class="mb-3 font-mono text-code text-dim">Kiln in live games</p>
        <h2 id="live-games-heading">I use Kiln in my own games.</h2>
      </div>
      <p class="max-w-reading text-dim">
        I build Kiln, Sheepdog Sim, OBJEKT-62 and ski sim. These games use Kiln-authored
        assets, adapted to their own rendering and gameplay. Working on them
        lets me test the whole path from editable source to an asset players
        actually encounter.
      </p>
    </div>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <article class="border-y border-rule py-6">
        <figure>
          <Image src={sheepdogGameShot} alt="A sheepdog faces the fenced pen, with the Kiln-authored farmhouse, red barn and trees behind it in Sheepdog Sim." widths={[480, 800, 1280, 1600]} sizes={CARD_SIZES} format="webp" loading="lazy" class="w-full" />
          <figcaption class="mt-2 font-mono text-code text-dim">House, barn, fences and trees in the game.</figcaption>
        </figure>
        <h3 class="mt-5">Sheepdog Sim</h3>
        <p class="mt-3 max-w-reading text-dim">
          A sheep herding game in your browser. I authored its house, barn,
          fences and trees with Kiln, then integrated them with the game's own
          materials and rendering.
        </p>
        <p class="mt-3 max-w-reading text-dim">
          The game is open source. Browse the repository to see how the assets
          fit into a working game.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          <a class="text-link" href="https://sheepdogsim.com/">
            Play Sheepdog Sim <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="https://github.com/matthew-kissinger/sds">
            Browse the source <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
      <article class="border-y border-rule py-6">
        <figure>
          <Image src={objektGameShot} alt="The Kiln-authored survey rifle in the foreground, an outpost and parked aircraft ahead, and a monument on the distant desert horizon in OBJEKT-62." widths={[480, 800, 1280, 1600]} sizes={CARD_SIZES} format="webp" loading="lazy" class="w-full" />
          <figcaption class="mt-2 font-mono text-code text-dim">Survey rifle and outpost · live 0.21.2.</figcaption>
        </figure>
        <h3 class="mt-5">OBJEKT-62</h3>
        <p class="mt-3 max-w-reading text-dim">
          A sci-fi survival game in your browser. I use Kiln for most of its
          3D assets, including guns, ship parts, vehicles, outpost modules and
          salvage. They are integrated with the game's own materials, collision
          and interaction systems.
        </p>
        <a class="text-link mt-5" href="https://objekt62.com/">
          Play OBJEKT-62 <span aria-hidden="true">↗</span>
        </a>
      </article>
      <article class="border-y border-rule py-6 md:col-span-2">
        <div class="grid gap-8 md:grid-cols-2">
          <figure>
            <Image src={skiVillageShot} alt="A skier grinding sideways beside a lit chalet, with pines, trail lights and a chairlift in the background." widths={[480, 800, 1280, 1440]} sizes={CARD_SIZES} format="webp" loading="lazy" class="w-full" />
            <figcaption class="mt-2 font-mono text-code text-dim">Skier, rail, chalet, pines and trail lights. Staged in-game on Village Bend.</figcaption>
          </figure>
          <figure>
            <video controls loop muted playsinline preload="none" poster={skiCharacterShot.src} width="1200" height="750" class="w-full" aria-label="A skier flips with a mute grab, then crashes into a Jolt ragdoll on Mutex Ridge">
              <source src="/live-games/ski-sim-flip-grab.mp4" type="video/mp4" />
              <a href="/live-games/ski-sim-flip-grab.mp4">Watch the ski sim jump</a>
            </video>
            <figcaption class="mt-2 font-mono text-code text-dim">Flip, mute grab and Jolt crash. In-game menu demonstration, filmed from the landing. <a class="text-link" href="/live-games/ski-sim-flip-grab.gif" download>Download GIF</a></figcaption>
          </figure>
        </div>
        <h3 class="mt-5">ski sim</h3>
        <p class="mt-3 max-w-reading text-dim">
          A freestyle skiing game for desktop and phone browsers. I use Kiln
          for its skier and outfit variants, pines, rocks, modular village
          buildings, trail lights, sign frames and terrain-park equipment.
          The game adds procedural animation, Jolt ragdolls, snow and lighting.
        </p>
        <a class="text-link mt-5" href="https://skisim.app/">
          Play ski sim <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>
  </section>
  {PACKS_ENABLED && <AssetToScene />}
  <section class="container section-space" aria-labelledby="agent-heading">
    <div class="grid gap-8 border-t border-ink pt-8 lg:grid-cols-2 lg:gap-12">
      <div class="min-w-0">
        <h2 id="agent-heading">Your coding agent drives the same tools.</h2>
        <p class="mt-6 max-w-reading">
          Kiln has no model of its own. Your agent supplies the model; no
          separate model key is needed.
        </p>
        <p class="mt-4 max-w-reading">
          Create a workspace with <code>kiln-init</code>. It writes the MCP
          configuration and skills for your harness. Follow the generated{" "}
          <code>START.md</code> to connect.
        </p>
        <ul
          class="mt-5 flex flex-wrap gap-2"
          aria-label="Supported harness flags"
        >
          {HARNESSES.map((h) => (
            <li class="border border-rule bg-sheet px-3 py-2 font-mono text-code">
              --harness {h}
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <CodeBlock
            code={WORKSPACE_COMMAND}
            lang="bash"
            label="Create an asset workspace"
          />
        </div>
      </div>
      <div class="min-w-0">
        <CodeBlock
          code={workflow.source.excerpt}
          lang="javascript"
          label="Timber wall cladding · source excerpt"
        />
        <p class="mt-3 text-caption text-dim">The wall’s source builds its cladding from individual boards. <a href={workflow.source.href} class="text-ink underline">Read the complete wall source.</a></p>
      </div>
    </div>
  </section>
  <section class="container" aria-labelledby="ships-heading">
    <div class="grid items-end gap-6 md:grid-cols-2">
      <h2 id="ships-heading">The local toolchain ships together.</h2>
      <p class="max-w-reading text-dim">
        The {VERSION_SHORT} package includes the tools, authoring
        guidance and local review interface. Add the GPU service when material
        appearance matters.
      </p>
    </div>
    <dl class="mt-8 border-t border-ink">
      {ship.map(([name, description, slug]) => (
        <div class="grid gap-2 border-b border-rule py-5 md:grid-cols-12 md:gap-6">
          <dt class="font-semibold md:col-span-3">
            <a class="text-link" href={docHref(slug!)}>
              {name}
            </a>
          </dt>
          <dd class="max-w-reading self-center md:col-span-9">{description}</dd>
        </div>
      ))}
    </dl>
  </section>
  <section class="container section-space" aria-labelledby="made-heading">
    <h2 id="made-heading" class="max-w-reading">Take a closer look at the assets.</h2>
    <p class="mt-5 max-w-reading text-dim">Browse vegetation, architecture, interiors and landscapes. Inspect the models, download GLBs or keep their editable source.</p>
    {PACKS_ENABLED && <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
      {featuredAssets.map((asset) => <AssetCard asset={asset} />)}
    </div>}
    <div class="mt-8 flex flex-wrap gap-6">
      <a class="text-link" href="/gallery/">Browse all assets</a>
      <a class="text-link" href="/scenes/">Explore all scenes</a>
      <a class="text-link" href="/packs/">Download asset packs</a>
      <a class="text-link" href="/gallery/archive/">Earlier asset archive</a>
    </div>
  </section>
  <section class="container" aria-labelledby="start-heading">
    <div class="grid gap-8 border-t border-ink pt-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <h2 id="start-heading" class="text-subheading">Try Kiln {VERSION_SHORT} locally.</h2>
        <p class="mt-5 max-w-reading">
          Install <code>@instruktlabs/kiln</code> from npm, then connect your coding
          agent to a local asset workspace. Use Node.js 22 or 24 LTS; the
          installation guide lists the complete compatibility range.
        </p>
        <p class="mt-4 max-w-reading text-dim">
          Local use is free and account-free. Your agent supplies the model;
          Kiln's tools need no separate model API key. Bun is only needed for
          engine development.
        </p>
          <p class="mt-4 max-w-lead text-dim">
            Want hosted access? <a href={DISCORD}>Join the Kiln Discord</a> and
            ask in #request-access or message matt_941.
            <a href="https://kiln.instruktlabs.com/">Hosted Kiln</a> is open by
            invitation, with ten introductory accounts sharing 200 native requests
            per month. Codes are sent privately as capacity allows. Local Kiln
            needs no account or invitation.
          </p>
        <a href="/docs/install/" class="text-link mt-3">
          Read the installation guide <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="min-w-0 space-y-4 lg:col-span-8">
        <CodeBlock
          code={`mkdir kiln-install\ncd kiln-install\nnpm init -y\n${INSTALL_COMMAND}`}
          lang="bash"
          label={`Install Kiln ${VERSION_SHORT}`}
        />
        <CodeBlock
          code={`${WORKSPACE_COMMAND}\ncd ../my-assets\n# Follow START.md for your harness`}
          lang="bash"
          label="Connect your coding agent"
        />
      </div>
    </div>
  </section>
</BaseLayout>

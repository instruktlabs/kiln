---
import { sceneRuntimes } from "virtual:kiln-scenes";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SceneShell from "../../components/SceneShell.astro";
import { farmScene } from "../../data/scenes";
import { FULL_WIDTH_IMAGE_SIZES } from "../../lib/catalog";
import { PACKS_ENABLED } from "../../lib/config";
// The Farm preview stays out of search results and the sitemap whatever
// farm.scene.available says; qualification, not this flag, decides when that changes.
---

<BaseLayout
  title="Shapes & Seasons Farm scene"
  description={sceneRuntimes.farm
    ? "A preview of the rebuilt interactive Farm, still being qualified. View its touch controls, device notes and the current runnable scene download."
    : "The interactive Farm is being rebuilt. View its status, device notes and current runnable scene download."}
  noindex
  nofollow
  breadcrumbs={[
    { label: "Scenes", href: "/scenes/" },
    { label: "Farm", href: "/scenes/farm/" },
  ]}
  ogImage="/social/scenes.jpg"
  preloadImage={
    PACKS_ENABLED
      ? {
          src: farmScene.poster,
          srcset: farmScene.posterImage.srcsetAvif,
          sizes: FULL_WIDTH_IMAGE_SIZES,
        }
      : undefined
  }
>
  <div class="container pb-12 pt-8">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="font-semibold">The Farm scene</h1>
        <p class="mt-4 max-w-prose text-lg">{farmScene.description}</p>
      </div>
      {PACKS_ENABLED && (
        <a href="/packs/farm/" class="btn btn-secondary">
          Farm pack and downloads
        </a>
      )}
    </div>
    <SceneShell scene="farm" />
    <div class="mt-8 grid gap-6 border-t border-rule pt-6 md:grid-cols-2 lg:grid-cols-3">
      <div>
        <h2 class="text-subheading font-semibold">{farmScene.touch.heading}</h2>
        <p class="mt-3">{farmScene.touch.intro}</p>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          {farmScene.touch.controls.map((line) => <li>{line}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-subheading font-semibold">
          {farmScene.touch.qualityHeading}
        </h2>
        {farmScene.touch.quality.map((line) => <p class="mt-3">{line}</p>)}
      </div>
      <div class="md:col-span-2 lg:col-span-1">
        <h2 class="text-subheading font-semibold">
          Use the current scene download.
        </h2>
        <p class="mt-3">
          {farmScene.desktop} {farmScene.mobile} {farmScene.exclusions} Extract
          the scene archive and run <code>node scene/serve.mjs</code>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

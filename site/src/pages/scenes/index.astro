---
import HolodeckShowcase from "../../components/HolodeckShowcase.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sceneRuntimes } from "virtual:kiln-scenes";
import { cabinWoodsScene, cathedralSquareScene, farmScene, foundryFloorScene, goldenGateScene, sceneBrowseGroups } from "../../data/scenes";
import SceneSelector from '../../components/SceneSelector.astro';
import { PACKS_ENABLED } from "../../lib/config";
import troy from "../../data/troy.json";
import ScenePoster from "../../components/ScenePoster.astro";

// Runtime availability controls each card's action; browsing groups describe when the scenes were made.
const cards = [
  {
    scene: cathedralSquareScene,
    alt: cathedralSquareScene.posterAlt,
    staged: 'Walk the square, cathedral nave and chapels. The scene loads only when you choose Explore.',
    unstaged: 'The browser scene is not included in this build.',
  },
  {
    scene: farmScene,
    alt: "Barn, farmhouse and fields in the Farm scene",
    staged:
      "Walk the farm in third person, drive the tractor and play with touch. The runnable scene is also available to download.",
    unstaged:
      "The browser scene is not included in this build. The current runnable scene is available in the Farm download.",
  },
  {
    scene: goldenGateScene,
    alt: goldenGateScene.posterAlt,
    staged:
      "Drive across the bridge or view the span by day, at golden hour or in fog. It loads only when you choose Explore.",
    unstaged:
      "The browser scene is not part of this build. The bridge asset has its own page and downloads.",
  },
  {
    scene: foundryFloorScene,
    alt: foundryFloorScene.posterAlt,
    staged:
      "Explore the campus and the fab floor. It loads only when you choose Explore.",
    unstaged:
      "The browser scene is not part of this build.",
  },
  {
    scene: cabinWoodsScene,
    alt: cabinWoodsScene.posterAlt,
    staged: "Walk the cabin and mixed woodland on desktop with WebGPU. Mobile play is not qualified.",
    unstaged: "The scene is not staged in this build; download it from the pack page.",
  },
] as const;
---

<BaseLayout
  title="Scenes · Kiln"
  description="Explore Cathedral Square, worlds on Holodeck, and earlier Kiln scenes including Troy, Farm and Golden Gate."
  breadcrumbs={[{ label: "Scenes", href: "/scenes/" }]}
  card="scenes"
>
  <div class="container py-8">
    <PageHeader class="max-w-prose font-semibold">Scenes</PageHeader>
    <SceneSelector />
    <p class="mt-6 max-w-prose text-lg">
      Scenes put individual assets into a place you can explore. They load only
      when you choose to open them.
    </p>
    {sceneBrowseGroups(PACKS_ENABLED).map(group => <>
      {group.id === 'earlier-kiln-scenes' && PACKS_ENABLED && <>
        <HolodeckShowcase id="featured-worlds" heading="Holodeck worlds" />
        <HolodeckShowcase id="more-worlds" heading="More Holodeck worlds" remaining />
      </>}
      <section aria-labelledby={group.id} class="mt-16 border-t border-ink pt-8">
        <h2 id={group.id} class="text-subheading">{group.label}</h2>
        <p class="mt-4 max-w-reading text-dim">{group.description}</p>
        {group.scenes.map(entry => {
      if (entry.id === 'troy') return <a href="/scenes/troy/" aria-label="Troy" class="no-underline text-ink mt-12 grid gap-8 border-t border-ink pt-8 lg:grid-cols-2"><ScenePoster images={troy.posters} sizes="(max-width: 1023px) 100vw, 50vw" decorative class="border border-rule" /><div><h3 class="font-semibold">Troy</h3><p class="mt-4 max-w-prose">{troy.description}</p><p class="mt-4 max-w-prose">Explore the city, watch the fleet land, or fight as either hero.</p><span class="text-link mt-6">Open the scene preview<span class="sr-only">: Troy</span></span></div></a>;
      const card = cards.find(card => card.scene.id === entry.id);
      if (!card) throw new Error(`Missing scene card: ${entry.id}`);
      const { scene, staged, unstaged } = card;
      const runtime = sceneRuntimes[scene.id];
      return (
        <a href={scene.href} aria-label={scene.name} class="no-underline text-ink mt-12 grid gap-8 border-t border-ink pt-8 lg:grid-cols-2">
          {PACKS_ENABLED && scene.posterImage && (
            <div>
              <ScenePoster
                images={scene.posterImages}
                sizes="(max-width: 1023px) 100vw, 50vw"
                decorative
                class="border border-rule"
              />
            </div>
          )}
          <div>
            <h3 class="font-semibold">{scene.name}</h3>
            <p class="mt-4 max-w-prose">{scene.description}</p>
            <p class="mt-4 max-w-prose">{runtime ? staged : unstaged}</p>
            <span class="text-link mt-6">
              {runtime ? "Open the scene preview" : "View the scene status"}
              <span class="sr-only">: {scene.name}</span>
            </span>

          </div>
        </a>
      );
        })}
      </section>
    </>)}
  </div>
</BaseLayout>

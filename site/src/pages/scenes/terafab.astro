---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terafab scene — in production"
  description="Terafab is the working title for a Kiln asset pack and scene in production."
  noindex
  breadcrumbs={[
    { label: "Scenes", href: "/scenes/" },
    { label: "Terafab", href: "/scenes/terafab/" },
  ]}
  ogImage="/social/terafab.webp"
>
  <div class="container py-20">
    <h1 class="max-w-prose font-semibold">
      The Terafab scene is in production.
    </h1>
    <p class="mt-6 max-w-prose text-lg">
      Terafab is a working title. The pack and its scene are being made; there
      is no browser scene to explore yet.
    </p>
    <a href="/scenes/" class="btn btn-secondary mt-8">
      Back to scenes
    </a>
  </div>
</BaseLayout>

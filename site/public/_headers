# Response headers for kilnstudio.tools on Cloudflare Pages (a direct upload of the reviewed build, decision S-4).
# Pages applies every rule whose path matches, in this order; "! Name" removes a header an earlier rule set.
# validate-static checks this file against the build: the CSP script hashes are exactly the inline scripts the
# pages carry. Immutable caching covers content-hashed files and exact sealed Troy resources verified by finalize-site.
# finalize-site replaces template script hashes and appends the verified sealed Troy cache rules for this build.

# Every response. HTML revalidates on each visit: a cached page that outlived a deployment would point at hashed
# files the new deployment no longer has. The permissions policy turns off device features no page uses and
# leaves WebGL, WebGPU and fullscreen alone. The content security policy is report-only: violations are logged in
# the browser console and nothing is blocked; enforcing it is the owner's decision after the hosted dogfood.
# Beyond the review's directives it allows what the measured pages use: 'wasm-unsafe-eval' for the viewer's
# WebAssembly mesh decoder and blob: in connect-src for GLB textures, which three.js fetches from blob: URLs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), bluetooth=(), camera=(), display-capture=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-wAGukfde07th8FeXAlx31NqovrboToJ/niuiFbyoI70=' 'sha256-nQyK+pVXDH5RpnnZ8bk4KjsgiC91NvDr20Qc7mo8J4w=' 'sha256-qsHLNpEk33lPgo1MnVDl/NNWHbeSVPK4+ksw8A84/ls=' 'sha256-pi2avave5D7tqBWNSP54Cy8gsoNF+VSK2JuekU4lFcg=' 'sha256-ynl5VnLFfq74TN1iDcyssM5zkT3yce8NSUQIazX5/GY='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' blob: https://assets.kilnstudio.tools; worker-src 'self' blob:

# The project's own pages.dev hosts serve these same bytes (production at kilnstudio.pages.dev, each deployment and
# branch alias beneath it), so they are kept out of search indexes; only https://kilnstudio.tools is indexed. Pages
# matches an absolute rule on its host, where ":name" is one label (developers.cloudflare.com/pages/configuration/headers/).
https://kilnstudio.pages.dev/*
  X-Robots-Tag: noindex

https://:version.kilnstudio.pages.dev/*
  X-Robots-Tag: noindex

# Raw data the scenes and gallery fetch: Search Console showed Google crawling these as documents
# (manifest.json, *.kiln-metadata.json, THIRD-PARTY-NOTICES.txt). X-Robots-Tag keeps a file out of the index and still
# lets anything fetch it, so the demos keep working. Never list these in robots.txt: a crawler cannot see
# the noindex on a blocked URL. One splat per rule and it crosses "/" (see headersFor), so "*.json" covers any depth.
# HTML is deliberately absent, and validate-static fails a build where one of these reaches a page or a sitemap URL.
/asset-demos/*.json
  X-Robots-Tag: noindex

/asset-demos/*.txt
  X-Robots-Tag: noindex

/asset-demos/*.md
  X-Robots-Tag: noindex

/asset-demos/*/SHA256SUMS
  X-Robots-Tag: noindex

/scene-packs/*.json
  X-Robots-Tag: noindex

/scene-packs/*.txt
  X-Robots-Tag: noindex

/scene-packs/*.md
  X-Robots-Tag: noindex

/scene-packs/*/SHA256SUMS
  X-Robots-Tag: noindex

# The same kind of file elsewhere: per-asset JSON the gallery fetches, runtime data, source notes, licence texts and
# build receipts. llms.txt, robots.txt, the sitemaps and .well-known stay indexable.
/asset-demos/*/LICENSE
  X-Robots-Tag: noindex

/asset-demos/*.lock
  X-Robots-Tag: noindex

/asset-demos/*/.gitignore
  X-Robots-Tag: noindex

/scene-packs/*/LICENSE
  X-Robots-Tag: noindex

/assets/*.json
  X-Robots-Tag: noindex

/scene-runtime/*.json
  X-Robots-Tag: noindex

/sources/*.md
  X-Robots-Tag: noindex

/fonts/*.txt
  X-Robots-Tag: noindex

/build-info.json
  X-Robots-Tag: noindex

/artifact-files.json
  X-Robots-Tag: noindex

/source-files.json
  X-Robots-Tag: noindex

# Build output named by content hash: a changed file gets a new name, so these never need revalidating.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The scene runtimes' chunks are named by content hash too (frame.html and runtime.json beside them are not).
/scene-runtime/:scene/*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The standalone H-7 game uses its own gamepad input; other site pages remain unchanged.
/play/h-7/*
  ! Permissions-Policy
  Permissions-Policy: accelerometer=(), bluetooth=(), camera=(), display-capture=(), gamepad=(self), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  X-Robots-Tag: noindex

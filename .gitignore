node_modules/
# `dist/*` and not `dist/`: git never descends into an excluded DIRECTORY, so a
# negation under `dist/` can never match and the bundle below stayed ignored
# while the docs said it was committed.
dist/*
# ...except the MCP server bundle. A plugin install is a git clone with no build
# step, so the artifact the harness launches has to be in the tree. Kept honest
# by src/__tests__/mcp-bundle.test.ts, which rebuilds it and compares bytes.
!dist/mcp-server.mjs
# ...and the engine it loads on the first call that needs it (same test).
!dist/mcp-engine.mjs
!dist/cli.mjs
!dist/evaluator-worker.mjs
!dist/build.json
!dist/agent-run.mjs
!dist/agent-providers.mjs
!dist/viewer/
.kiln/
coverage/
# `kiln render` writes here when no --out is given, so it lands at the repo
# root every time anyone tries the README's first command.
/out.glb
*.tsbuildinfo
*.log
.DS_Store
.env
.env.*
!.env.example
.localdata/
tmp/
# Disposable Node bundle for the checked-in Discovery research source.
/scripts/research-discovery/production-benchmark.mjs
/scripts/research-discovery/production-scale.mjs

# Dogfooding runs by dispatched CLI agents (scripts/dispatch-asset.mjs)
.dogfood/

# The gallery site's payload is generated, not authored: `site/scripts/build-assets.mjs`
# runs every program in examples/ and writes the GLBs, the thumbnails and the
# index out of what the engine returns. Committing 24 MB of GLB would also mean
# committing a copy that can silently stop matching the program beside it.
site/public/assets/
site/public/thumbs/
site/dist/

# Same reason, for the well-known skills index: `site/scripts/build-skills-discovery.mjs`
# derives it from `skills/`, and its published sha256 digests would go stale the
# moment a skill changed if a copy were committed here instead.
site/public/.well-known/

# Locally staged, revision-bound Troy owner-review bundles.
site/public/troy-review/

# Local agent config (launch profiles, per-machine settings). The shipped
# plugin manifest lives in .claude-plugin/, which is tracked.
# .claude/ is local state. The exception is .claude/skills/, which is committed so
# a bare clone registers the setup skill; git will not descend into a wholly
# excluded directory, hence the `/*` form rather than `.claude/`.
.claude/*
!.claude/skills/

# Gallery posters are fetched from R2 by site/scripts/verify-assets.mjs and cached here.
.poster-cache/

# Gallery images are rendered here and published to R2 by scripts/upload-posters.mjs.
.posters/

# Local wrangler simulator state. `wrangler r2 object put` without --remote
# writes uploads here instead of the bucket; none of it belongs in git.
.wrangler/

# Removed from history on 2026-09-10 and served from R2 instead; see
# docs/plans/repo-size-and-r2-migration-2026-09-10.md. The 83 JSON receipts in
# examples/renders/ stay tracked -- they are the provenance record. The images
# they attest do not, because 117 MB of history bought nothing the tools need.
examples/renders/*.png
examples/renders/*.gif

# Social-media masters. Archived at ~/kiln-media-archive/ and referenced by no
# file in the repository; the README video is served by GitHub's asset CDN.
assets/video/

# Local qualification captures and build caches; preserved outside release source.
/qa/
/.cache/

# Troy public files are staged from their sealed asset-host archive.
site/public/scene-packs/troy/
